/* Cube (matrix unit) peak throughput for the Ascend 950DT.
 *
 * Measurement model, mirroring triton_chip_benchmarks/bench_tensor.py's peak
 * mode: operands are loaded into L0A/L0B once per launch, then a single MMAD
 * tile is issued ITERATIONS times accumulating into a resident L0C. No global
 * memory traffic enters the timed loop, so what is measured is the matrix
 * unit's issue rate rather than a memory-bound GEMM.
 *
 * Operation count = 2 * M * N * K * iterations * blocks (one multiply plus one
 * add per MAC). FLOP/s for floats, OP/s for INT8.
 *
 * On-chip capacity on this architecture (enforced by the linker):
 *   L0A, L0B   64 KiB each      L0C  128 KiB      L1  512 KiB
 * The tile shape is a runtime argument so a single kernel per dtype covers the
 * whole sweep; buffers are declared at the capacity limit.
 *
 * Correctness: every configuration is validated against an exact host
 * reference before it is timed. Operands are small exact values, so the
 * accumulated FP32/INT32 result is exactly representable and the expected
 * error is identically zero - a layout or addressing mistake cannot hide. A
 * configuration that fails validation never contributes a peak.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include "bench_common.h"

#define FRAC_MN 16u   /* NZ fractal M/N rows; the Cube consumes 16x16 fractals */

/* One kernel per translation unit, selected by -DBENCH_CUBE_DTYPE.
 *
 * Two constraints force this shape:
 *  - The linker sums static on-chip allocations across every kernel in a
 *    module, and L0A/L0B hold only 64 KiB each with L0C at 128 KiB, so several
 *    kernels cannot each declare full-size buffers.
 *  - Aliasing one shared file-scope pool through casts avoids that, but makes
 *    bisheng's on-chip allocator pathological: the same kernel compiles in
 *    ~4 s with local declarations and fails to finish in 25 minutes with pool
 *    casts. Local declarations plus one kernel per binary keeps both the
 *    capacity limits and the compile time.
 *
 * The tile shape is a runtime argument, so one kernel covers the whole sweep.
 */
#define CUBE_BF16 1
#define CUBE_FP16 2
#define CUBE_FP32 3
#define CUBE_TF32 4
#define CUBE_INT8 5
#define CUBE_FP8  6
#define CUBE_FP4  7

#ifndef BENCH_CUBE_DTYPE
#error "define BENCH_CUBE_DTYPE to one of CUBE_BF16..CUBE_FP4"
#endif

/* Per-dtype operand type, accumulator type, K elements per 32-byte C0 block,
 * and the element capacity of a 64 KiB L0 buffer. */
#if BENCH_CUBE_DTYPE == CUBE_BF16
  #define OPERAND_T   bfloat16_t
  #define ACCUM_T     float
  #define K_PER_C0    16u
  #define L0_ELEMS    32768u
  #define DTYPE_NAME  "bf16"
#elif BENCH_CUBE_DTYPE == CUBE_FP16
  #define OPERAND_T   half
  #define ACCUM_T     float
  #define K_PER_C0    16u
  #define L0_ELEMS    32768u
  #define DTYPE_NAME  "fp16"
#elif BENCH_CUBE_DTYPE == CUBE_FP32
  #define OPERAND_T   float
  #define ACCUM_T     float
  #define K_PER_C0    8u
  #define L0_ELEMS    16384u
  #define DTYPE_NAME  "fp32"
#elif BENCH_CUBE_DTYPE == CUBE_TF32
  #define OPERAND_T   float
  #define ACCUM_T     float
  #define K_PER_C0    8u
  #define L0_ELEMS    16384u
  #define DTYPE_NAME  "tf32"
  #define CUBE_ENABLE_HF32 1
#elif BENCH_CUBE_DTYPE == CUBE_INT8
  #define OPERAND_T   int8_t
  #define ACCUM_T     int32_t
  #define K_PER_C0    32u
  #define L0_ELEMS    65536u
  #define DTYPE_NAME  "int8"
  #define CUBE_INTEGER 1
#elif BENCH_CUBE_DTYPE == CUBE_FP8
  #define OPERAND_T   fp8_e4m3fn_t
  #define ACCUM_T     float
  #define K_PER_C0    32u
  #define L0_ELEMS    65536u
  #define DTYPE_NAME  "fp8"
#elif BENCH_CUBE_DTYPE == CUBE_FP4
  #define OPERAND_T   fp4x2_e2m1_t
  #define ACCUM_T     float
  #define K_PER_C0    64u
  /* fp4x2_e2m1_t is byte sized and packs two FP4 elements, so a 64 KiB L0
   * buffer is 65536 of these units and holds 131072 FP4 elements. */
  #define L0_ELEMS    65536u
  #define L0_FP4_ELEMENTS 131072u
  #define DTYPE_NAME  "fp4"
  #define CUBE_MX 1
#else
  #error "unknown BENCH_CUBE_DTYPE"
#endif

#define L0C_ELEMS 32768u            /* 128 KiB of FP32/INT32 accumulator */

#if BENCH_CUBE_DTYPE == CUBE_FP4
/* FP4 (E2M1) through the MX matrix path.
 *
 * asc_mmad_mx applies one E8M0 scale factor per 64 K elements per operand row,
 * loaded into the L0 scale register file by asc_copy_l12l0a_mx /
 * asc_copy_l12l0b_mx. The host supplies all-2^0 scales (E8M0 code 127), so the
 * arithmetic value equals the raw FP4 product and the reference stays exact
 * while the hardware still runs the full MX dataflow including scale
 * application.
 *
 * K counts FP4 elements; storage packs two per byte. The host lays the operands
 * out in NZ order itself because there is no ND2NZ path for 4-bit storage. */
__cube__ __global__ void cube_peak(__gm__ fp4x2_e2m1_t* a, __gm__ fp4x2_e2m1_t* b,
                                   __gm__ int16_t* sfa, __gm__ int16_t* sfb,
                                   __gm__ float* c, uint32_t m, uint32_t n, uint32_t k,
                                   uint32_t iterations) {
    asc_init();
    __cbuf__ fp4x2_e2m1_t a1[L0_ELEMS];
    __cbuf__ fp4x2_e2m1_t b1[L0_ELEMS];
    __cbuf__ int16_t sfa1[4096];
    __cbuf__ int16_t sfb1[4096];
    __ca__ fp4x2_e2m1_t a2[L0_ELEMS];
    __cb__ fp4x2_e2m1_t b2[L0_ELEMS];
    __cc__ float acc[L0C_ELEMS];
    const uint32_t sf_pairs = k / 64u;

    /* Operands arrive as raw NZ-ordered bytes prepared by the host. There is
     * no 4-bit GM->L1 path, so the transfer runs as a byte copy over the
     * packed storage - the same approach DeepGEMM-Ascend takes for its FP4
     * operands. One burst covers the whole contiguous block. */
    asc_copy_gm2l1_align((__cbuf__ uint8_t*)a1, (__gm__ uint8_t*)a, 1u, m * k / 2u, 0, 0,
                         false, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);
    asc_copy_gm2l1_align((__cbuf__ uint8_t*)b1, (__gm__ uint8_t*)b, 1u, n * k / 2u, 0, 0,
                         false, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);
    asc_copy_gm2l1_align((__cbuf__ uint8_t*)sfa1, (__gm__ uint8_t*)sfa, 1u,
                         m * sf_pairs * 2u, 0, 0, false,
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);
    asc_copy_gm2l1_align((__cbuf__ uint8_t*)sfb1, (__gm__ uint8_t*)sfb, 1u,
                         n * sf_pairs * 2u, 0, 0, false,
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    asc_copy_l12l0a(a2, a1, 0, 0, m / FRAC_MN, k / K_PER_C0, m / FRAC_MN, m / FRAC_MN);
    asc_copy_l12l0b(b2, b1, 0, 0, n / FRAC_MN, k / K_PER_C0, n / FRAC_MN, n / FRAC_MN);
    /* Scale factors into the L0 MX register file; the destination is a byte
     * address divided by 16. */
    asc_copy_l12l0a_mx((uint64_t)(uintptr_t)a2 / 16u, (__cbuf__ fp8_e8m0_t*)sfa1,
                       0, 0, m / FRAC_MN, sf_pairs, sf_pairs, sf_pairs);
    asc_copy_l12l0b_mx((uint64_t)(uintptr_t)b2 / 16u, (__cbuf__ fp8_e8m0_t*)sfb1,
                       0, 0, n / FRAC_MN, sf_pairs, sf_pairs, sf_pairs);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

    for (uint32_t i = 0; i < iterations; ++i)
        asc_mmad_mx(acc, a2, b2, m, k, n, asc_unit_flag_mode::DISABLE, true, false, i == 0);

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(c + (uint64_t)block_idx * m * n, acc, n, m, n, m,
                    asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
                    asc_unit_flag_mode::DISABLE, QuantMode_t::NoQuant,
                    asc_relu_pre_mode::NONE, false, true, false, false);
    asc_sync_pipe(PIPE_ALL);
}

#else  /* every non-MX operand type */

/* A is [M,K] K-major and B is [N,K] K-major, so C = A @ B^T and neither
 * operand needs the transposing L1->L0 path. TF32 differs from FP32 only in
 * enabling HF32 rounding, which switches the Cube to its 19-bit (TF32-class)
 * multiply on the same FP32 storage. */
__cube__ __global__ void cube_peak(__gm__ OPERAND_T* a, __gm__ OPERAND_T* b,
                                   __gm__ ACCUM_T* c, uint32_t m, uint32_t n, uint32_t k,
                                   uint32_t iterations) {
    asc_init();
#ifdef CUBE_ENABLE_HF32
    asc_enable_hf32();
    asc_set_hf32_round_mode(asc_hf32_round_mode::NEAREST_EVEN);
#endif
    __cbuf__ OPERAND_T a1[L0_ELEMS];
    __cbuf__ OPERAND_T b1[L0_ELEMS];
    __ca__ OPERAND_T a2[L0_ELEMS];
    __cb__ OPERAND_T b2[L0_ELEMS];
    __cc__ ACCUM_T acc[L0C_ELEMS];

    /* GM -> L1, converting the row-major source into the NZ layout L0 needs. */
    asc_set_gm2l1_nz_para(1, 1, (uint16_t)m, 0);
    asc_copy_gm2l1_nd2nz(a1, a, k * sizeof(OPERAND_T),
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, m, k, 0, false);
    asc_set_gm2l1_nz_para(1, 1, (uint16_t)n, 0);
    asc_copy_gm2l1_nd2nz(b1, b, k * sizeof(OPERAND_T),
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, n, k, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    asc_copy_l12l0a(a2, a1, 0, 0, m / FRAC_MN, k / K_PER_C0, m / FRAC_MN, m / FRAC_MN);
    asc_copy_l12l0b(b2, b1, 0, 0, n / FRAC_MN, k / K_PER_C0, n / FRAC_MN, n / FRAC_MN);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

    /* Timed region: resident operands, repeated MMAD into a resident L0C. */
    for (uint32_t i = 0; i < iterations; ++i)
        asc_mmad(acc, a2, b2, m, k, n, asc_unit_flag_mode::DISABLE, false, false, i == 0);

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
#ifdef CUBE_ENABLE_HF32
    asc_disable_hf32();
#endif
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(c + (uint64_t)block_idx * m * n, acc, n, m, n, m,
                    asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
                    asc_unit_flag_mode::DISABLE, QuantMode_t::NoQuant,
                    asc_relu_pre_mode::NONE, false, true, false, false);
    asc_sync_pipe(PIPE_ALL);
}
#endif

/* ============================== host driver ============================== */

/* This binary measures exactly the dtype it was compiled for. The suite
 * driver builds one binary per dtype and selects by name; --dtype is accepted
 * only to confirm the caller wants this binary's dtype, so a mismatched
 * invocation fails loudly instead of silently reporting the wrong format. */
static const char* const kDtypeName = DTYPE_NAME;

#ifdef CUBE_INTEGER
  static const int kIntegerMetric = 1;
#else
  static const int kIntegerMetric = 0;
#endif

typedef struct { uint32_t m, n, k; } cube_shape;

typedef struct {
    cube_shape shape;
    uint32_t blocks, iterations;
    void *a, *b, *c, *sfa, *sfb;
    aclrtStream stream;
} cube_context;

static void cube_launch(void* opaque) {
    cube_context* context = (cube_context*)opaque;
    const uint32_t m = context->shape.m, n = context->shape.n, k = context->shape.k;
#if BENCH_CUBE_DTYPE == CUBE_FP4
    cube_peak<<<context->blocks, 0, context->stream>>>(
        (__gm__ fp4x2_e2m1_t*)context->a, (__gm__ fp4x2_e2m1_t*)context->b,
        (__gm__ int16_t*)context->sfa, (__gm__ int16_t*)context->sfb,
        (__gm__ float*)context->c, m, n, k, context->iterations);
#else
    cube_peak<<<context->blocks, 0, context->stream>>>(
        (__gm__ OPERAND_T*)context->a, (__gm__ OPERAND_T*)context->b,
        (__gm__ ACCUM_T*)context->c, m, n, k, context->iterations);
#endif
}

/* ---------------------------- operand preparation ------------------------- */

static uint32_t bench_rand_state = 1u;
static inline uint32_t bench_rand(void) {
    bench_rand_state = bench_rand_state * 1664525u + 1013904223u;
    return bench_rand_state >> 8;
}

/* NZ (fractal) layout for the FP4 operands.
 *
 * NZ orders a [MN, K] matrix as: for each C0 block of FRAC_K elements along K,
 * all MN rows contiguously with 32 bytes per row. For FP4, FRAC_K is 64
 * elements, which is exactly 32 bytes, so element (mn, k) lands at
 *   byte = (k / 64) * MN * 32 + mn * 32 + (k % 64) / 2
 * with the low nibble holding the even-indexed element. */
static void fp4_pack_nz(uint8_t* destination, const float* source,
                        uint32_t mn, uint32_t k) {
    memset(destination, 0, (size_t)mn * k / 2u);
    for (uint32_t row = 0; row < mn; ++row) {
        for (uint32_t column = 0; column < k; ++column) {
            uint8_t code = bench_float_to_fp4_e2m1(source[(size_t)row * k + column]);
            size_t byte = (size_t)(column / 64u) * mn * 32u + (size_t)row * 32u
                        + (column % 64u) / 2u;
            if (column & 1u) destination[byte] |= (uint8_t)(code << 4);
            else             destination[byte] |= code;
        }
    }
}

int main(int argc, char** argv) {
    int32_t device_id = 0;
    const char* dtype_argument = DTYPE_NAME;
    uint32_t iterations = 512;
    const char* output_path = NULL;
    int quick = 0;

    for (int i = 1; i < argc; ++i) {
        if (!strcmp(argv[i], "--device") && i + 1 < argc) device_id = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--dtype") && i + 1 < argc) dtype_argument = argv[++i];
        else if (!strcmp(argv[i], "--iterations") && i + 1 < argc) iterations = (uint32_t)atoi(argv[++i]);
        else if (!strcmp(argv[i], "--output") && i + 1 < argc) output_path = argv[++i];
        else if (!strcmp(argv[i], "--quick")) quick = 1;
        else {
            fprintf(stderr, "usage: %s [--device N] [--dtype %s] "
                    "[--iterations N] [--output FILE] [--quick]\n", argv[0], DTYPE_NAME);
            return 2;
        }
    }

    /* Refuse a dtype this binary was not built for, rather than measuring one
     * format and labelling it another. */
    if (strcmp(dtype_argument, kDtypeName) != 0) {
        fprintf(stderr, "this binary measures %s, not %s; "
                        "use bench_cube_%s\n", kDtypeName, dtype_argument, dtype_argument);
        return 2;
    }

    BENCH_CHECK(aclInit(NULL));
    BENCH_CHECK(aclrtSetDevice(device_id));
    aclrtStream stream = NULL;
    BENCH_CHECK(aclrtCreateStream(&stream));

    bench_device_info device;
    bench_query_device(device_id, &device);
    printf("Device %d: %s (arch %lld) | cube cores=%lld vector cores=%lld | L2=%lld MiB | "
           "HBM=%.2f GiB (free %.2f GiB)",
           (int)device_id, device.soc_name, (long long)device.npu_arch,
           (long long)device.cube_core_num, (long long)device.vector_core_num,
           (long long)(device.l2_cache_bytes / 1048576),
           (double)device.total_memory_bytes / 1073741824.0,
           (double)device.free_memory_bytes / 1073741824.0);
    if (device.aicore_freq_mhz > 0) printf(" | %.0f MHz", device.aicore_freq_mhz);
    printf("\n");

    FILE* output = output_path ? fopen(output_path, "w") : NULL;
    if (output_path && !output) { fprintf(stderr, "cannot write %s\n", output_path); return 1; }
    bench_json json;
    bench_json_init(&json, output ? output : stdout);

    const int integer_metric = kIntegerMetric;
    const char* unit = integer_metric ? "TOP/s" : "TFLOP/s";

    /* Candidate tile shapes. Each must satisfy, for operand size s bytes:
     *   M*K*s <= 64 KiB, N*K*s <= 64 KiB, M*N*4 <= 128 KiB,
     * and M, N multiples of 16 with K a multiple of the per-dtype C0. */
    cube_shape shapes[6];
    int shape_count = 0;
#if BENCH_CUBE_DTYPE == CUBE_BF16 || BENCH_CUBE_DTYPE == CUBE_FP16
    shapes[shape_count++] = (cube_shape){128, 256, 128};
    shapes[shape_count++] = (cube_shape){256, 128, 128};
    shapes[shape_count++] = (cube_shape){128, 128, 128};
    shapes[shape_count++] = (cube_shape){128, 128, 256};
    shapes[shape_count++] = (cube_shape){64, 64, 128};
#elif BENCH_CUBE_DTYPE == CUBE_FP32 || BENCH_CUBE_DTYPE == CUBE_TF32
    shapes[shape_count++] = (cube_shape){128, 128, 64};
    shapes[shape_count++] = (cube_shape){128, 256, 64};
    shapes[shape_count++] = (cube_shape){256, 128, 64};
    shapes[shape_count++] = (cube_shape){64, 64, 128};
    shapes[shape_count++] = (cube_shape){64, 128, 64};
#elif BENCH_CUBE_DTYPE == CUBE_INT8 || BENCH_CUBE_DTYPE == CUBE_FP8
    shapes[shape_count++] = (cube_shape){128, 256, 256};
    shapes[shape_count++] = (cube_shape){256, 128, 256};
    shapes[shape_count++] = (cube_shape){128, 128, 512};
    shapes[shape_count++] = (cube_shape){128, 128, 256};
    shapes[shape_count++] = (cube_shape){256, 256, 128};
#elif BENCH_CUBE_DTYPE == CUBE_FP4
    shapes[shape_count++] = (cube_shape){128, 256, 512};
    shapes[shape_count++] = (cube_shape){256, 128, 512};
    shapes[shape_count++] = (cube_shape){128, 128, 1024};
    shapes[shape_count++] = (cube_shape){128, 128, 512};
    shapes[shape_count++] = (cube_shape){256, 256, 256};
#endif
    if (quick) { shape_count = 1; iterations = 64; }

    uint32_t blocks_per_core_values[4] = {1, 2, 4, 8};
    int blocks_per_core_count = quick ? 1 : 4;
    const uint32_t cores = (uint32_t)(device.cube_core_num > 0 ? device.cube_core_num
                                                              : device.aicore_num);
    if (cores == 0) {
        fprintf(stderr, "[FATAL] the runtime reported no Cube core count\n");
        return 1;
    }

    printf("\nCube matrix peak: %s operands, resident L0A/L0B, %u MMAD iterations per launch\n",
           kDtypeName, iterations);
    printf("Operations = 2 * M * N * K * iterations * blocks; peak uses the shortest timed sample\n");
    printf("  tile M/N/K    blocks   median ms     min ms   median %-8s  peak %-8s  check\n",
           unit, unit);

    if (output) {
        bench_json_begin_document(&json);
        bench_json_string(&json, "benchmark", "cube_tensor_peak");
        bench_json_string(&json, "dtype", kDtypeName);
        bench_json_string(&json, "unit", unit);
        bench_json_int(&json, "iterations", iterations);
        bench_json_string(&json, "measurement_kind",
#if BENCH_CUBE_DTYPE == CUBE_FP4
            "native_mx_fp4_mmad_peak"
#elif BENCH_CUBE_DTYPE == CUBE_TF32
            "native_hf32_mmad_peak"
#else
            "native_mmad_peak"
#endif
        );
        bench_json_string(&json, "accumulator_dtype", integer_metric ? "int32" : "fp32");
        bench_json_string(&json, "operation_count_formula",
                          "2 * M * N * K * iterations * blocks");
        bench_json_bool(&json, "native_instruction", 1);
        bench_json_open_array(&json, "results");
    }

    double best_peak = -1.0, best_median = -1.0;
    cube_shape best_shape = {0, 0, 0};
    uint32_t best_blocks = 0;
    int any_ok = 0;

    for (int s = 0; s < shape_count; ++s) {
        const cube_shape shape = shapes[s];
        const uint32_t m = shape.m, n = shape.n, k = shape.k;

        for (int bi = 0; bi < blocks_per_core_count; ++bi) {
            const uint32_t blocks = blocks_per_core_values[bi] * cores;
            const size_t c_elements = (size_t)blocks * m * n;
            size_t sf_a_bytes = 0, sf_b_bytes = 0;
            const size_t c_bytes = c_elements * 4;
#if BENCH_CUBE_DTYPE == CUBE_FP4
            /* Two FP4 elements per byte, plus one E8M0 scale per 64 K. */
            const size_t a_bytes = (size_t)m * k / 2;
            const size_t b_bytes = (size_t)n * k / 2;
            sf_a_bytes = (size_t)m * (k / 64) * 2;
            sf_b_bytes = (size_t)n * (k / 64) * 2;
#else
            const size_t a_bytes = (size_t)m * k * sizeof(OPERAND_T);
            const size_t b_bytes = (size_t)n * k * sizeof(OPERAND_T);
#endif
            if (c_bytes + a_bytes + b_bytes + 512u * 1048576u > device.free_memory_bytes) {
                printf("%5u/%u/%-6u %7u   skipped (needs %.2f GiB, free %.2f GiB)\n",
                       m, n, k, blocks, (double)c_bytes / 1073741824.0,
                       (double)device.free_memory_bytes / 1073741824.0);
                continue;
            }

            /* Reference operands in float, then converted to storage type. */
            float* reference_a = (float*)malloc((size_t)m * k * sizeof(float));
            float* reference_b = (float*)malloc((size_t)n * k * sizeof(float));
            bench_rand_state = 20261105u + (uint32_t)s * 977u;
#if defined(CUBE_INTEGER) || BENCH_CUBE_DTYPE == CUBE_FP4
            {
                /* Ternary integers keep every product and partial sum exact. */
                for (size_t i = 0; i < (size_t)m * k; ++i)
                    reference_a[i] = (float)((int)(bench_rand() % 3u) - 1);
                for (size_t i = 0; i < (size_t)n * k; ++i)
                    reference_b[i] = (float)((int)(bench_rand() % 3u) - 1);
            }
#else
            {
                /* Ternary times 1/8: exact binary fractions. */
                for (size_t i = 0; i < (size_t)m * k; ++i)
                    reference_a[i] = (float)((int)(bench_rand() % 3u) - 1) * 0.125f;
                for (size_t i = 0; i < (size_t)n * k; ++i)
                    reference_b[i] = (float)((int)(bench_rand() % 3u) - 1) * 0.125f;
            }
#endif

            void* host_a = malloc(a_bytes);
            void* host_b = malloc(b_bytes);
#if BENCH_CUBE_DTYPE == CUBE_BF16
            for (size_t i = 0; i < (size_t)m * k; ++i)
                ((uint16_t*)host_a)[i] = bench_float_to_bf16(reference_a[i]);
            for (size_t i = 0; i < (size_t)n * k; ++i)
                ((uint16_t*)host_b)[i] = bench_float_to_bf16(reference_b[i]);
#elif BENCH_CUBE_DTYPE == CUBE_FP16
            for (size_t i = 0; i < (size_t)m * k; ++i)
                ((uint16_t*)host_a)[i] = bench_float_to_fp16(reference_a[i]);
            for (size_t i = 0; i < (size_t)n * k; ++i)
                ((uint16_t*)host_b)[i] = bench_float_to_fp16(reference_b[i]);
#elif BENCH_CUBE_DTYPE == CUBE_FP32 || BENCH_CUBE_DTYPE == CUBE_TF32
            memcpy(host_a, reference_a, a_bytes);
            memcpy(host_b, reference_b, b_bytes);
#elif BENCH_CUBE_DTYPE == CUBE_INT8
            for (size_t i = 0; i < (size_t)m * k; ++i)
                ((int8_t*)host_a)[i] = (int8_t)reference_a[i];
            for (size_t i = 0; i < (size_t)n * k; ++i)
                ((int8_t*)host_b)[i] = (int8_t)reference_b[i];
#elif BENCH_CUBE_DTYPE == CUBE_FP8
            for (size_t i = 0; i < (size_t)m * k; ++i)
                ((uint8_t*)host_a)[i] = bench_float_to_fp8_e4m3(reference_a[i]);
            for (size_t i = 0; i < (size_t)n * k; ++i)
                ((uint8_t*)host_b)[i] = bench_float_to_fp8_e4m3(reference_b[i]);
#elif BENCH_CUBE_DTYPE == CUBE_FP4
            fp4_pack_nz((uint8_t*)host_a, reference_a, m, k);
            fp4_pack_nz((uint8_t*)host_b, reference_b, n, k);
#endif

            void *device_a = NULL, *device_b = NULL, *device_c = NULL;
            void *device_sf_a = NULL, *device_sf_b = NULL;
            BENCH_CHECK(aclrtMalloc(&device_a, a_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
            BENCH_CHECK(aclrtMalloc(&device_b, b_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
            BENCH_CHECK(aclrtMalloc(&device_c, c_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
            BENCH_CHECK(aclrtMemcpy(device_a, a_bytes, host_a, a_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
            BENCH_CHECK(aclrtMemcpy(device_b, b_bytes, host_b, b_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#if BENCH_CUBE_DTYPE == CUBE_FP4
            {
                /* E8M0 code 127 is 2^0; two codes are packed per int16. */
                int16_t* host_sf_a = (int16_t*)malloc(sf_a_bytes);
                int16_t* host_sf_b = (int16_t*)malloc(sf_b_bytes);
                const int16_t unit_pair = (int16_t)((127 << 8) | 127);
                for (size_t i = 0; i < sf_a_bytes / 2; ++i) host_sf_a[i] = unit_pair;
                for (size_t i = 0; i < sf_b_bytes / 2; ++i) host_sf_b[i] = unit_pair;
                BENCH_CHECK(aclrtMalloc(&device_sf_a, sf_a_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
                BENCH_CHECK(aclrtMalloc(&device_sf_b, sf_b_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
                BENCH_CHECK(aclrtMemcpy(device_sf_a, sf_a_bytes, host_sf_a, sf_a_bytes,
                                        ACL_MEMCPY_HOST_TO_DEVICE));
                BENCH_CHECK(aclrtMemcpy(device_sf_b, sf_b_bytes, host_sf_b, sf_b_bytes,
                                        ACL_MEMCPY_HOST_TO_DEVICE));
                free(host_sf_a); free(host_sf_b);
            }
#endif

            cube_context context;
            context.shape = shape; context.blocks = blocks;
            context.iterations = iterations;
            context.a = device_a; context.b = device_b; context.c = device_c;
            context.sfa = device_sf_a; context.sfb = device_sf_b;
            context.stream = stream;

            /* ---- validate before timing ---- */
            /* Poison the output so a kernel that never writes cannot pass. */
            BENCH_CHECK(aclrtMemset(device_c, c_bytes, 0xFF, c_bytes));
            cube_launch(&context);
            aclError launch_status = aclrtSynchronizeStream(stream);
            int validated = 0;
            double max_absolute_error = 0.0;
            if (launch_status != ACL_SUCCESS) {
                printf("%5u/%u/%-6u %7u   launch failed: %d (%s)\n", m, n, k, blocks,
                       (int)launch_status, aclGetRecentErrMsg());
            } else {
                void* host_c = malloc(c_bytes);
                BENCH_CHECK(aclrtMemcpy(host_c, c_bytes, device_c, c_bytes,
                                        ACL_MEMCPY_DEVICE_TO_HOST));
                validated = 1;
                for (uint32_t row = 0; row < m && validated; ++row) {
                    for (uint32_t column = 0; column < n; ++column) {
                        double expected = 0.0;
                        for (uint32_t inner = 0; inner < k; ++inner)
                            expected += (double)reference_a[(size_t)row * k + inner]
                                      * (double)reference_b[(size_t)column * k + inner];
                        expected *= (double)iterations;
                        double observed = integer_metric
                            ? (double)((int32_t*)host_c)[(size_t)row * n + column]
                            : (double)((float*)host_c)[(size_t)row * n + column];
                        double error = bench_fabs(observed - expected);
                        if (error > max_absolute_error) max_absolute_error = error;
                        if (error > 1e-6) {
                            printf("%5u/%u/%-6u %7u   VALIDATION FAILED at (%u,%u): "
                                   "got %.10g expected %.10g\n",
                                   m, n, k, blocks, row, column, observed, expected);
                            validated = 0;
                            break;
                        }
                    }
                }
                /* Every block ran the identical tile; all must agree with block 0. */
                if (validated) {
                    const size_t per_block = (size_t)m * n * 4;
                    for (uint32_t block = 1; block < blocks; ++block) {
                        if (memcmp(host_c, (const char*)host_c + (size_t)block * per_block,
                                   per_block) != 0) {
                            printf("%5u/%u/%-6u %7u   VALIDATION FAILED: block %u differs "
                                   "from block 0\n", m, n, k, blocks, block);
                            validated = 0;
                            break;
                        }
                    }
                }
                free(host_c);
            }

            if (validated) {
                bench_timing_config timing_config = bench_default_timing();
                if (quick) {
                    timing_config.warmup_ms = 10; timing_config.rep_ms = 20;
                    timing_config.rounds = 3;
                }
                bench_timing_result timing;
                if (bench_measure(cube_launch, &context, stream, &timing_config, &timing) == 0) {
                    const double operations = 2.0 * m * n * k * iterations * blocks;
                    const double peak = operations / (timing.min_ms * 1e9);
                    const double median = operations / (timing.median_ms * 1e9);
                    printf("%5u/%u/%-6u %7u  %10.5f %10.5f %17.2f %15.2f  exact\n",
                           m, n, k, blocks, timing.median_ms, timing.min_ms, median, peak);
                    fflush(stdout);
                    any_ok = 1;
                    if (peak > best_peak) {
                        best_peak = peak; best_median = median;
                        best_shape = shape; best_blocks = blocks;
                    }
                    if (output) {
                        bench_json_open_object(&json, NULL);
                        bench_json_int(&json, "block_m", m);
                        bench_json_int(&json, "block_n", n);
                        bench_json_int(&json, "block_k", k);
                        bench_json_int(&json, "blocks", blocks);
                        bench_json_int(&json, "blocks_per_core", blocks / cores);
                        bench_json_double(&json, "operation_count", operations);
                        bench_json_double(&json, "peak_throughput", peak);
                        bench_json_double(&json, "median_throughput", median);
                        bench_json_string(&json, "unit", unit);
                        bench_json_string(&json, "status", "ok");
                        bench_json_string(&json, "correctness",
                            "every output exact against the host reference (zero tolerance)");
                        bench_json_double(&json, "max_abs_error", max_absolute_error);
                        bench_json_timing(&json, &timing);
                        bench_json_close_object(&json);
                    }
                } else {
                    printf("%5u/%u/%-6u %7u   timing did not resolve\n", m, n, k, blocks);
                }
            }

            aclrtFree(device_a); aclrtFree(device_b); aclrtFree(device_c);
            if (device_sf_a) aclrtFree(device_sf_a);
            if (device_sf_b) aclrtFree(device_sf_b);
            free(host_a); free(host_b); free(reference_a); free(reference_b);
        }
    }

    if (output) bench_json_close_array(&json);

    if (any_ok) {
        printf("\nMeasured Cube %s peak: %.2f %s (same configuration median %.2f %s) "
               "at tile %u/%u/%u, %u blocks\n",
               kDtypeName, best_peak, unit, best_median, unit,
               best_shape.m, best_shape.n, best_shape.k, best_blocks);
        if (output) {
            bench_json_return_to_root(&json);
            bench_json_string(&json, "status", "ok");
            bench_json_double(&json, "value", best_peak);
            bench_json_double(&json, "median_value", best_median);
            bench_json_int(&json, "best_block_m", best_shape.m);
            bench_json_int(&json, "best_block_n", best_shape.n);
            bench_json_int(&json, "best_block_k", best_shape.k);
            bench_json_int(&json, "best_blocks", best_blocks);
        }
    } else {
        printf("\nNo configuration produced a validated measurement.\n");
        if (output) {
            bench_json_return_to_root(&json);
            bench_json_string(&json, "status", "error");
            bench_json_string(&json, "reason", "no configuration validated and timed");
            bench_json_null(&json, "value");
            bench_json_null(&json, "median_value");
        }
    }

    if (output) {
                bench_json_device(&json, &device);
        bench_json_end_document(&json);
        fclose(output);
        printf("JSON: %s\n", output_path);
    }

    BENCH_CHECK(aclrtDestroyStream(stream));
    BENCH_CHECK(aclrtResetDevice(device_id));
    aclFinalize();
    return any_ok ? 0 : 1;
}
