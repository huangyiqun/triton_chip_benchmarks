/* FP64 capability report for the Ascend 950DT.
 *
 * This is not a benchmark. Both execution paths the suite covers lack any
 * FP64 instruction on this architecture, which is a property of the ISA and
 * can be stated from the headers rather than measured:
 *
 *   Cube (matrix):  asc_mmad and asc_mmad_mx have overloads for bfloat16_t,
 *                   half, float, int8_t, int4b_t, fp8_e4m3fn_t, fp8_e5m2_t,
 *                   hifloat8_t and the fp4x2 types. There is no double
 *                   overload, so there is no FP64 matrix instruction.
 *
 *   Vector (AIV):   the RegBase vector register types are vector_f16,
 *                   vector_bf16, vector_f32, the integer widths, and the
 *                   narrow float types. There is no 64-bit float vector type
 *                   and no double-precision asc_madd/asc_fma/asc_mul, so
 *                   there is no FP64 vector arithmetic.
 *
 * The suite still emits both FP64 rows, with no numeric value and an explicit
 * reason, so a missing capability is never confused with a failed measurement
 * or silently reported as zero.
 *
 * Build one binary per unit with -DFP64_UNIT=FP64_CUBE or FP64_VECTOR.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"

#include "bench_common.h"

#define FP64_CUBE   1
#define FP64_VECTOR 2

#ifndef FP64_UNIT
#error "define FP64_UNIT to FP64_CUBE or FP64_VECTOR"
#endif

#if FP64_UNIT == FP64_CUBE
  #define UNIT_BENCHMARK "cube_tensor_peak"
  #define UNIT_REASON \
      "The Ascend 950DT Cube matrix unit exposes no FP64 instruction: asc_mmad " \
      "and asc_mmad_mx provide overloads for bfloat16_t, half, float, int8_t, " \
      "int4b_t, fp8_e4m3fn_t, fp8_e5m2_t, hifloat8_t and the fp4x2 types, and no " \
      "double-precision overload exists"
#elif FP64_UNIT == FP64_VECTOR
  #define UNIT_BENCHMARK "vector_peak"
  #define UNIT_REASON \
      "The Ascend 950DT RegBase vector ISA exposes no FP64 vector type or " \
      "double-precision arithmetic: there is no 64-bit float vector register " \
      "type and no double-precision asc_madd, asc_fma or asc_mul"
#else
  #error "unknown FP64_UNIT"
#endif

int main(int argc, char** argv) {
    int32_t device_id = 0;
    const char* output_path = NULL;

    for (int i = 1; i < argc; ++i) {
        if (!strcmp(argv[i], "--device") && i + 1 < argc) device_id = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--output") && i + 1 < argc) output_path = argv[++i];
        else if (!strcmp(argv[i], "--dtype") && i + 1 < argc) {
            if (strcmp(argv[++i], "fp64") != 0) {
                fprintf(stderr, "this binary reports fp64 only\n");
                return 2;
            }
        }
        else if (!strcmp(argv[i], "--quick")) { /* nothing is measured either way */ }
        else if (!strcmp(argv[i], "--iterations") && i + 1 < argc) { ++i; }
        else {
            fprintf(stderr, "usage: %s [--device N] [--dtype fp64] [--output FILE]\n", argv[0]);
            return 2;
        }
    }

    /* The device is opened only to record which chip the claim applies to. */
    BENCH_CHECK(aclInit(NULL));
    BENCH_CHECK(aclrtSetDevice(device_id));
    bench_device_info device;
    bench_query_device(device_id, &device);

    printf("Device %d: %s (arch %lld)\n", (int)device_id, device.soc_name,
           (long long)device.npu_arch);
    printf("UNSUPPORTED: %s\n", UNIT_REASON);

    if (output_path) {
        FILE* output = fopen(output_path, "w");
        if (!output) { fprintf(stderr, "cannot write %s\n", output_path); return 1; }
        bench_json json;
        bench_json_init(&json, output);
        bench_json_begin_document(&json);
        bench_json_string(&json, "benchmark", UNIT_BENCHMARK);
        bench_json_string(&json, "dtype", "fp64");
        bench_json_string(&json, "status", "unsupported");
        bench_json_string(&json, "reason", UNIT_REASON);
        bench_json_string(&json, "determined_from",
                          "Ascend C C API instruction set for dav-3510; no measurement attempted");
        bench_json_null(&json, "value");
        bench_json_null(&json, "median_value");
        bench_json_string(&json, "unit", "TFLOP/s");
                bench_json_device(&json, &device);
        bench_json_end_document(&json);
        fclose(output);
        printf("JSON: %s\n", output_path);
    }

    BENCH_CHECK(aclrtResetDevice(device_id));
    aclFinalize();
    return 0;
}
