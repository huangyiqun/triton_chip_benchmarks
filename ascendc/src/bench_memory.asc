/* Device memory capacity and achieved HBM bandwidth for the Ascend 950DT.
 *
 * Capacity is the runtime-reported device capacity, not a measurement.
 *
 * Bandwidth mirrors triton_chip_benchmarks/bench_bandwidth.py: a copy kernel
 * streams one HBM-sized buffer to another and a read kernel streams one buffer
 * into a per-block reduction.
 *   copy traffic = 2 * buffer bytes (read + write)
 *   read traffic = buffer bytes + the small reduction sink
 * Buffers are sized to at least 4x the 128 MiB L2 so the traffic really
 * reaches HBM; a configuration that does not meet that is reported but
 * excluded from the peak. Rates use decimal GB/s (1e9 bytes/s).
 *
 * Both kernels are validated in full before timing: the copy's destination
 * must equal its source element for element, and every block's reduction must
 * match a host sum. Values are chosen so the FP32 sum is exact.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include "bench_common.h"

/* UB staging, in FP32 elements.
 *
 * Both kernels are software pipelined across two groups: while group g is
 * being drained (stored for copy, reduced for read), group g+1 is already
 * loading. That keeps MTE2 busy during the drain instead of idling behind a
 * barrier, and it is what separates a bandwidth-bound kernel from a
 * latency-bound one.
 *
 * An earlier version alternated "load a group" and "drain a group" separated
 * by full asc_sync() barriers. Measured on an idle 950DT at 2 GiB, that form
 * reaches 2719 GB/s read where this one reaches 3928 - a 44% difference that
 * is purely the pipeline, not the hardware. It also beats a load-only kernel
 * with no reduction at all (3655 GB/s), which confirms the barrier version was
 * limited by its own serialization rather than by DMA.
 *
 * Synchronization uses per-pipe events rather than a whole-core barrier:
 * MTE2 signals the consuming pipe that a group has landed, and the consuming
 * pipe signals MTE2 that a group's buffers may be refilled. Two events per
 * direction, indexed by which half is in flight.
 *
 * GROUP_FLOATS is the staging area per group. Two groups plus the reduction
 * accumulator stay inside the 216 KiB per vector core this device reports.
 * The accumulator sits past every staging buffer so a chunk load can never
 * overwrite it. The number of chunks per group is GROUP_FLOATS /
 * chunk_elements, computed at runtime so chunk size stays sweepable.
 *
 * MAX_CHUNK_BYTES is a hard correctness limit, not a tuning choice.
 * asc_copy_gm2ub / asc_copy_ub2gm take their byte count in a 16-bit field and
 * wrap silently past it: measured on this CANN build, a requested 65536 bytes
 * transfers 0, 65540 transfers 4, and 98304 transfers 32768, with no error
 * raised. A chunk at or above 64 KiB therefore moves far less data than the
 * benchmark would charge it for. That is exactly how a bandwidth benchmark
 * fabricates a result: a 16384-element (64 KiB) chunk measured 8270 GB/s here,
 * roughly 2.5x the real HBM rate, and the read pattern still "validated"
 * because the periodic source made a short read sum to the expected value.
 * The sweep is capped below 64 KiB and the host asserts it. */
#define GROUP_FLOATS 16384u
#define MAX_CHUNK_BYTES 32768u
#define ACCUMULATOR_LANES 64u

__ubuf__ uint8_t g_ub[(2u * GROUP_FLOATS + ACCUMULATOR_LANES) * 4u];

/* ---------------------------------- copy ----------------------------------
 * Each block streams its own contiguous slice GM->UB->GM. The host enforces
 * that chunks_per_block is a multiple of the per-group chunk count, so no
 * partial group needs handling. */
__vector__ __global__ void bandwidth_copy(__gm__ float* source,
                                          __gm__ float* destination,
                                          uint32_t chunks_per_block,
                                          uint32_t chunk_elements) {
    asc_init();
    __ubuf__ float* buffers = (__ubuf__ float*)g_ub;
    const uint64_t base = (uint64_t)block_idx * chunks_per_block * chunk_elements;
    const uint32_t bytes = chunk_elements * (uint32_t)sizeof(float);
    const uint32_t per_group = GROUP_FLOATS / chunk_elements;

    /* Prime the pipeline with group 0 into half 0. */
    for (uint32_t slot = 0; slot < per_group; ++slot)
        asc_copy_gm2ub(buffers + slot * chunk_elements,
                       source + base + (uint64_t)slot * chunk_elements, bytes);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);

    uint32_t half = 0;
    for (uint32_t chunk = 0; chunk < chunks_per_block; chunk += per_group) {
        const uint32_t next_chunk = chunk + per_group;
        const uint32_t next_half = 1u - half;
        /* Issue the next group's loads before draining this one. */
        if (next_chunk < chunks_per_block) {
            if (chunk > 0)
                asc_sync_wait(PIPE_MTE3, PIPE_MTE2, (event_t)(EVENT_ID2 + next_half));
            for (uint32_t slot = 0; slot < per_group; ++slot)
                asc_copy_gm2ub(buffers + next_half * GROUP_FLOATS + slot * chunk_elements,
                               source + base + (uint64_t)(next_chunk + slot) * chunk_elements,
                               bytes);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE3, (event_t)(EVENT_ID0 + next_half));
        }
        asc_sync_wait(PIPE_MTE2, PIPE_MTE3, (event_t)(EVENT_ID0 + half));
        for (uint32_t slot = 0; slot < per_group; ++slot)
            asc_copy_ub2gm(destination + base + (uint64_t)(chunk + slot) * chunk_elements,
                           buffers + half * GROUP_FLOATS + slot * chunk_elements, bytes);
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, (event_t)(EVENT_ID2 + half));
        half = next_half;
    }
    asc_sync_pipe(PIPE_ALL);
}

/* ---------------------------------- read ----------------------------------
 * Streams the buffer and reduces every loaded element, so no load can be
 * eliminated. One FP32 partial sum per block is written back; that small sink
 * traffic is counted in the reported rate. */
__simd_vf__ inline void reduce_vf(__ubuf__ float* data, __ubuf__ float* accumulator,
                                  uint32_t element_count) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(float));
    const uint16_t repeats = (uint16_t)(element_count / lanes);
    /* asc_update_mask_b32 takes the remaining element count by reference and
     * decrements it by one register's worth per call, so the mask is full for
     * every whole register and the counter is re-primed for each pass. */
    vector_float total;
    asc_load(total, accumulator);
    uint32_t remaining = element_count;
    for (uint16_t repeat = 0; repeat < repeats; ++repeat) {
        vector_bool mask = asc_update_mask_b32(remaining);
        vector_float values;
        asc_load(values, data + (uint32_t)repeat * lanes);
        total = asc_add(total, values, mask);
    }
    asc_store(accumulator, total);
}

__vector__ __global__ void bandwidth_read(__gm__ float* source, __gm__ float* sink,
                                          uint32_t chunks_per_block,
                                          uint32_t chunk_elements) {
    asc_init();
    __ubuf__ float* buffers = (__ubuf__ float*)g_ub;
    __ubuf__ float* accumulator = buffers + 2u * GROUP_FLOATS;
    const uint64_t base = (uint64_t)block_idx * chunks_per_block * chunk_elements;
    const uint32_t bytes = chunk_elements * (uint32_t)sizeof(float);
    const uint32_t per_group = GROUP_FLOATS / chunk_elements;

    for (uint32_t lane = 0; lane < ACCUMULATOR_LANES; ++lane) accumulator[lane] = 0.0f;
    asc_sync();

    /* Prime the pipeline with group 0 into half 0. */
    for (uint32_t slot = 0; slot < per_group; ++slot)
        asc_copy_gm2ub(buffers + slot * chunk_elements,
                       source + base + (uint64_t)slot * chunk_elements, bytes);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint32_t half = 0;
    for (uint32_t chunk = 0; chunk < chunks_per_block; chunk += per_group) {
        const uint32_t next_chunk = chunk + per_group;
        const uint32_t next_half = 1u - half;
        /* Issue the next group's loads before reducing this one, so MTE2 and
         * the vector pipe overlap instead of alternating. */
        if (next_chunk < chunks_per_block) {
            if (chunk > 0)
                asc_sync_wait(PIPE_V, PIPE_MTE2, (event_t)(EVENT_ID2 + next_half));
            for (uint32_t slot = 0; slot < per_group; ++slot)
                asc_copy_gm2ub(buffers + next_half * GROUP_FLOATS + slot * chunk_elements,
                               source + base + (uint64_t)(next_chunk + slot) * chunk_elements,
                               bytes);
            asc_sync_notify(PIPE_MTE2, PIPE_V, (event_t)(EVENT_ID0 + next_half));
        }
        asc_sync_wait(PIPE_MTE2, PIPE_V, (event_t)(EVENT_ID0 + half));
        for (uint32_t slot = 0; slot < per_group; ++slot)
            asc_vf_call<reduce_vf>(buffers + half * GROUP_FLOATS + slot * chunk_elements,
                                   accumulator, chunk_elements);
        asc_sync_notify(PIPE_V, PIPE_MTE2, (event_t)(EVENT_ID2 + half));
        half = next_half;
    }
    asc_sync();

    /* Fold the lane-wise partial sums into one value and publish it. */
    float total = 0.0f;
    for (uint32_t lane = 0; lane < ACCUMULATOR_LANES; ++lane) total += accumulator[lane];
    accumulator[0] = total;
    asc_sync();
    asc_copy_ub2gm(sink + block_idx, accumulator, (uint32_t)sizeof(float));
    asc_sync_pipe(PIPE_ALL);
}

/* ============================== host driver ============================== */

typedef struct {
    int read_mode;
    uint32_t blocks, chunks_per_block, chunk_elements;
    void *source, *destination, *sink;
    aclrtStream stream;
} bandwidth_context;

static void bandwidth_launch(void* opaque) {
    bandwidth_context* context = (bandwidth_context*)opaque;
    if (context->read_mode)
        bandwidth_read<<<context->blocks, 0, context->stream>>>(
            (__gm__ float*)context->source, (__gm__ float*)context->sink,
            context->chunks_per_block, context->chunk_elements);
    else
        bandwidth_copy<<<context->blocks, 0, context->stream>>>(
            (__gm__ float*)context->source, (__gm__ float*)context->destination,
            context->chunks_per_block, context->chunk_elements);
}

int main(int argc, char** argv) {
    int32_t device_id = 0;
    const char* output_path = NULL;
    const char* mode_argument = "all";
    int quick = 0;

    for (int i = 1; i < argc; ++i) {
        if (!strcmp(argv[i], "--device") && i + 1 < argc) device_id = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--mode") && i + 1 < argc) mode_argument = argv[++i];
        else if (!strcmp(argv[i], "--output") && i + 1 < argc) output_path = argv[++i];
        else if (!strcmp(argv[i], "--quick")) quick = 1;
        else {
            fprintf(stderr, "usage: %s [--device N] [--mode copy|read|all] "
                            "[--output FILE] [--quick]\n", argv[0]);
            return 2;
        }
    }
    const int want_copy = !strcmp(mode_argument, "copy") || !strcmp(mode_argument, "all");
    const int want_read = !strcmp(mode_argument, "read") || !strcmp(mode_argument, "all");
    if (!want_copy && !want_read) { fprintf(stderr, "unknown --mode %s\n", mode_argument); return 2; }

    BENCH_CHECK(aclInit(NULL));
    BENCH_CHECK(aclrtSetDevice(device_id));
    aclrtStream stream = NULL;
    BENCH_CHECK(aclrtCreateStream(&stream));

    bench_device_info device;
    bench_query_device(device_id, &device);
    printf("Device %d: %s (arch %lld) | vector cores=%lld | L2=%lld MiB | "
           "HBM=%.2f GiB (free %.2f GiB)\n",
           (int)device_id, device.soc_name, (long long)device.npu_arch,
           (long long)device.vector_core_num,
           (long long)(device.l2_cache_bytes / 1048576),
           (double)device.total_memory_bytes / 1073741824.0,
           (double)device.free_memory_bytes / 1073741824.0);

    FILE* output = output_path ? fopen(output_path, "w") : NULL;
    if (output_path && !output) { fprintf(stderr, "cannot write %s\n", output_path); return 1; }
    bench_json json;
    bench_json_init(&json, output ? output : stdout);

    /* -------- capacity: reported, not measured -------- */
    const double capacity_gib = (double)device.total_memory_bytes / 1073741824.0;
    printf("\nMemory capacity: %.2f GiB (%lld bytes), reported by the runtime\n",
           capacity_gib, (long long)device.total_memory_bytes);

    const uint32_t cores = (uint32_t)device.vector_core_num;
    if (cores == 0) {
        fprintf(stderr, "[FATAL] the runtime reported no vector core count\n");
        return 1;
    }

    /* Buffer sizes in MiB. A size qualifies for the peak only when it is at
     * least 4x L2, so the measured traffic genuinely reaches HBM. */
    uint32_t sizes_mib[4] = {512, 1024, 2048, 4096};
    int size_count = quick ? 1 : 4;
    if (quick) sizes_mib[0] = 64;

    /* Grid and chunk size are swept, not assumed. Holding them at one vector
     * core per block and one chunk size understates the read rate badly: on an
     * idle 950DT at 2 GiB, 64 blocks reaches 3907 GB/s while 256 reaches 3928,
     * and 32 blocks collapses to 2493 because too few DMA engines are active.
     * Grids above the core count oversubscribe deliberately - the extra blocks
     * queue more outstanding loads per core. */
    uint32_t block_choices[4] = {cores / 2u, cores, cores * 2u, cores * 4u};
    int block_count = quick ? 1 : 4;
    if (quick) block_choices[0] = cores;
    uint32_t chunk_choices[3] = {2048u, 4096u, 8192u};
    int chunk_count = quick ? 1 : 3;
    if (quick) chunk_choices[0] = 8192u;
    /* Guard the DMA byte-count limit documented at MAX_CHUNK_BYTES. A chunk at
     * or above 64 KiB wraps silently and would report a fabricated rate. */
    for (int ci = 0; ci < chunk_count; ++ci) {
        if (chunk_choices[ci] * sizeof(float) > MAX_CHUNK_BYTES) {
            fprintf(stderr, "[FATAL] chunk %u exceeds the %u-byte DMA limit\n",
                    chunk_choices[ci], MAX_CHUNK_BYTES);
            return 1;
        }
    }

    printf("\nBandwidth: UB-staged streaming, two groups of %u FP32 in flight per block\n",
           GROUP_FLOATS);
    printf("Copy traffic = 2 * buffer bytes; read traffic = buffer bytes + per-block FP32 sink\n");
    printf("Peak eligibility requires a buffer of at least 4x L2 (%lld MiB)\n",
           (long long)(4 * device.l2_cache_bytes / 1048576));
    printf("mode   buffer MiB  blocks   chunk    median ms     min ms   peak GB/s  median GB/s  eligible  check\n");

    if (output) {
        bench_json_begin_document(&json);
        bench_json_string(&json, "benchmark", "memory_capacity_and_bandwidth");
        bench_json_open_object(&json, "memory_capacity");
        bench_json_double(&json, "value", capacity_gib);
        bench_json_string(&json, "unit", "GiB");
        bench_json_int(&json, "capacity_bytes", device.total_memory_bytes);
        bench_json_string(&json, "status", "ok");
        bench_json_string(&json, "measurement_kind", "reported_device_capacity");
        bench_json_close_object(&json);
        bench_json_string(&json, "bandwidth_unit", "GB/s");
        bench_json_string(&json, "bandwidth_definition",
            "effective bytes requested by the kernel; copy counts read+write, "
            "read counts the buffer plus the per-block FP32 sink; decimal GB/s");
        bench_json_open_array(&json, "bandwidth_results");
    }

    double best_copy_peak = -1.0, best_copy_median = -1.0;
    double best_read_peak = -1.0, best_read_median = -1.0;
    uint32_t best_copy_mib = 0, best_read_mib = 0;
    uint32_t best_copy_blocks = 0, best_read_blocks = 0;
    uint32_t best_copy_chunk = 0, best_read_chunk = 0;
    int any_ok = 0;

    for (int si = 0; si < size_count; ++si) {
        const uint32_t size_mib = sizes_mib[si];
        const size_t buffer_bytes = (size_t)size_mib * 1048576u;
        const size_t elements = buffer_bytes / sizeof(float);
        const int peak_eligible = !quick
            && buffer_bytes >= 4u * (size_t)device.l2_cache_bytes;

        for (int read_mode = 0; read_mode < 2; ++read_mode) {
            if (read_mode && !want_read) continue;
            if (!read_mode && !want_copy) continue;

            const size_t max_sink_bytes = (size_t)block_choices[block_count - 1] * sizeof(float);
            const size_t required = buffer_bytes * (read_mode ? 1u : 2u) + max_sink_bytes;
            if (required + 512u * 1048576u > device.free_memory_bytes) {
                printf("%-5s %10u    skipped (needs %.2f GiB, free %.2f GiB)\n",
                       read_mode ? "read" : "copy", size_mib,
                       (double)required / 1073741824.0,
                       (double)device.free_memory_bytes / 1073741824.0);
                continue;
            }

            void *device_source = NULL, *device_destination = NULL, *device_sink = NULL;
            BENCH_CHECK(aclrtMalloc(&device_source, buffer_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
            if (!read_mode)
                BENCH_CHECK(aclrtMalloc(&device_destination, buffer_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
            BENCH_CHECK(aclrtMalloc(&device_sink, max_sink_bytes, ACL_MEM_MALLOC_HUGE_FIRST));

            /* Source values are exact small binary fractions so every partial
             * sum is exactly representable and the read check has zero
             * tolerance. The pattern is deliberately NOT uniform across the
             * buffer: the period-8 base (which sums to -0.5) is scaled by a
             * group index that changes every 8192 elements, so a block that
             * reduced the wrong region, reduced it twice, or reduced only part
             * of its slice lands on a different total.
             *
             * This matters. An earlier purely periodic pattern let a silently
             * truncated DMA pass validation while reporting 8270 GB/s, about
             * 2.5x the real HBM rate: every 8-element window summed the same,
             * so a short read was indistinguishable from a complete one.
             * Scaling by 1..4 keeps every value a multiple of 1/8 bounded by
             * 2, so all partial sums stay exactly representable in FP32. */
            float* host_source = (float*)malloc(buffer_bytes);
            for (size_t i = 0; i < elements; ++i)
                host_source[i] = (float)((int)(i % 8u) - 4) * 0.125f
                               * (float)(1u + ((i >> 13) & 3u));
            BENCH_CHECK(aclrtMemcpy(device_source, buffer_bytes, host_source, buffer_bytes,
                                    ACL_MEMCPY_HOST_TO_DEVICE));

            for (int bi = 0; bi < block_count; ++bi) {
            for (int ci = 0; ci < chunk_count; ++ci) {
            const uint32_t blocks = block_choices[bi];
            const uint32_t chunk_elements = chunk_choices[ci];
            const size_t sink_bytes = (size_t)blocks * sizeof(float);
            /* The grid must cover the buffer exactly, every block must hold a
             * whole number of pipeline groups, and a group must hold a whole
             * number of chunks. */
            if (blocks == 0 || GROUP_FLOATS % chunk_elements != 0) continue;
            if (elements % ((size_t)blocks * GROUP_FLOATS) != 0) continue;
            const uint32_t chunks_per_block =
                (uint32_t)(elements / ((size_t)blocks * chunk_elements));

            bandwidth_context context;
            context.read_mode = read_mode; context.blocks = blocks;
            context.chunks_per_block = chunks_per_block;
            context.chunk_elements = chunk_elements;
            context.source = device_source; context.destination = device_destination;
            context.sink = device_sink; context.stream = stream;

            /* ---- validate before timing ---- */
            if (!read_mode) BENCH_CHECK(aclrtMemset(device_destination, buffer_bytes, 0xFF, buffer_bytes));
            BENCH_CHECK(aclrtMemset(device_sink, max_sink_bytes, 0xFF, max_sink_bytes));
            bandwidth_launch(&context);
            aclError launch_status = aclrtSynchronizeStream(stream);
            int validated = 0;
            if (launch_status != ACL_SUCCESS) {
                printf("%-5s %10u %7u %7u  launch failed: %d (%s)\n", read_mode ? "read" : "copy",
                       size_mib, blocks, chunk_elements, (int)launch_status, aclGetRecentErrMsg());
            } else if (!read_mode) {
                float* host_destination = (float*)malloc(buffer_bytes);
                BENCH_CHECK(aclrtMemcpy(host_destination, buffer_bytes, device_destination,
                                        buffer_bytes, ACL_MEMCPY_DEVICE_TO_HOST));
                validated = (memcmp(host_source, host_destination, buffer_bytes) == 0);
                if (!validated)
                    printf("%-5s %10u %7u %7u  VALIDATION FAILED: destination differs from source\n",
                           "copy", size_mib, blocks, chunk_elements);
                free(host_destination);
            } else {
                float* host_sink = (float*)malloc(sink_bytes);
                BENCH_CHECK(aclrtMemcpy(host_sink, sink_bytes, device_sink, sink_bytes,
                                        ACL_MEMCPY_DEVICE_TO_HOST));
                validated = 1;
                /* Each block summed its own whole contiguous slice. The base
                 * pattern repeats every 8 elements with a period sum of
                 * exactly -0.5, scaled by a group index that changes every
                 * 8192 elements, so the expected total is closed form:
                 * -0.5 * 1024 per group run, times that run's 1..4 scale.
                 * Exact in FP32, and O(groups) rather than O(buffer) for each
                 * swept configuration. */
                const size_t per_block = (size_t)chunks_per_block * chunk_elements;
                for (uint32_t block = 0; block < blocks && validated; ++block) {
                    const size_t base = (size_t)block * per_block;
                    double expected = 0.0;
                    for (size_t off = 0; off < per_block; off += 8192u)
                        expected += -512.0 * (double)(1u + (((base + off) >> 13) & 3u));
                    const double observed = (double)host_sink[block];
                    if (observed != expected) {
                        printf("%-5s %10u %7u %7u  VALIDATION FAILED: block %u sum %.10g, expected %.10g\n",
                               "read", size_mib, blocks, chunk_elements, block, observed, expected);
                        validated = 0;
                    }
                }
                free(host_sink);
            }

            if (validated) {
                bench_timing_config timing_config = bench_default_timing();
                if (quick) { timing_config.warmup_ms = 10; timing_config.rep_ms = 20; timing_config.rounds = 3; }
                bench_timing_result timing;
                if (bench_measure(bandwidth_launch, &context, stream, &timing_config, &timing) == 0) {
                    const double traffic = read_mode
                        ? (double)buffer_bytes + (double)sink_bytes
                        : 2.0 * (double)buffer_bytes;
                    const double peak = traffic / (timing.min_ms * 1e6);
                    const double median = traffic / (timing.median_ms * 1e6);
                    printf("%-5s %10u %7u %7u   %10.4f %10.4f %11.2f %12.2f  %-8s  exact\n",
                           read_mode ? "read" : "copy", size_mib, blocks, chunk_elements,
                           timing.median_ms,
                           timing.min_ms, peak, median, peak_eligible ? "yes" : "no");
                    fflush(stdout);
                    any_ok = 1;
                    if (peak_eligible) {
                        if (read_mode && peak > best_read_peak) {
                            best_read_peak = peak; best_read_median = median; best_read_mib = size_mib;
                            best_read_blocks = blocks; best_read_chunk = chunk_elements;
                        }
                        if (!read_mode && peak > best_copy_peak) {
                            best_copy_peak = peak; best_copy_median = median; best_copy_mib = size_mib;
                            best_copy_blocks = blocks; best_copy_chunk = chunk_elements;
                        }
                    }
                    if (output) {
                        bench_json_open_object(&json, NULL);
                        bench_json_string(&json, "pattern", read_mode ? "read" : "copy");
                        bench_json_int(&json, "buffer_mib", size_mib);
                        bench_json_int(&json, "buffer_bytes", (long long)buffer_bytes);
                        bench_json_int(&json, "blocks", blocks);
                        bench_json_int(&json, "chunks_per_block", chunks_per_block);
                        bench_json_int(&json, "chunk_elements", chunk_elements);
                        bench_json_double(&json, "traffic_bytes", traffic);
                        bench_json_double(&json, "peak_gbps", peak);
                        bench_json_double(&json, "median_gbps", median);
                        bench_json_bool(&json, "peak_eligible", peak_eligible);
                        bench_json_string(&json, "cache_regime",
                            peak_eligible ? "larger_than_4x_l2" : "cache_sensitive_or_quick");
                        bench_json_string(&json, "status", "ok");
                        bench_json_string(&json, "correctness", read_mode
                            ? "every block reduction exact against the host sum"
                            : "destination equals source for every element");
                        bench_json_timing(&json, &timing);
                        bench_json_close_object(&json);
                    }
                } else {
                    printf("%-5s %10u %7u %7u  timing did not resolve\n",
                           read_mode ? "read" : "copy", size_mib, blocks, chunk_elements);
                }
            }
            }  /* chunk sweep */
            }  /* block sweep */

            aclrtFree(device_source);
            if (device_destination) aclrtFree(device_destination);
            aclrtFree(device_sink);
            free(host_source);
        }
    }

    if (output) bench_json_close_array(&json);

    /* The suite's single bandwidth figure is the copy pattern, matching the
     * Triton suite; the read rate is reported alongside as a detail. */
    if (best_copy_peak > 0)
        printf("\nMeasured copy bandwidth: %.2f GB/s (%.3f TB/s), same configuration median "
               "%.2f GB/s, at %u MiB per buffer, %u blocks, %u-element chunks\n",
               best_copy_peak, best_copy_peak / 1000.0,
               best_copy_median, best_copy_mib, best_copy_blocks, best_copy_chunk);
    if (best_read_peak > 0)
        printf("Measured read bandwidth: %.2f GB/s (%.3f TB/s), same configuration median "
               "%.2f GB/s, at %u MiB, %u blocks, %u-element chunks\n",
               best_read_peak, best_read_peak / 1000.0,
               best_read_median, best_read_mib, best_read_blocks, best_read_chunk);
    if (best_copy_peak <= 0 && best_read_peak <= 0)
        printf("\nNo HBM-sized configuration produced a validated measurement.\n");

    if (output) {
        bench_json_return_to_root(&json);
        bench_json_open_object(&json, "memory_bandwidth");
        if (best_copy_peak > 0) {
            bench_json_string(&json, "status", "ok");
            bench_json_double(&json, "value", best_copy_peak);
            bench_json_double(&json, "median_value", best_copy_median);
            bench_json_int(&json, "best_buffer_mib", best_copy_mib);
            bench_json_int(&json, "best_blocks", best_copy_blocks);
            bench_json_int(&json, "best_chunk_elements", best_copy_chunk);
        } else {
            bench_json_string(&json, "status", "error");
            bench_json_string(&json, "reason",
                              "no HBM-sized copy configuration validated and timed");
            bench_json_null(&json, "value");
            bench_json_null(&json, "median_value");
        }
        bench_json_string(&json, "unit", "GB/s");
        bench_json_string(&json, "pattern", "copy");
        if (best_read_peak > 0) {
            bench_json_double(&json, "read_peak_gbps", best_read_peak);
            bench_json_double(&json, "read_median_gbps", best_read_median);
            bench_json_int(&json, "read_best_blocks", best_read_blocks);
            bench_json_int(&json, "read_best_chunk_elements", best_read_chunk);
        }
        bench_json_close_object(&json);
                bench_json_device(&json, &device);
        bench_json_end_document(&json);
        fclose(output);
        printf("JSON: %s\n", output_path);
    }

    BENCH_CHECK(aclrtDestroyStream(stream));
    BENCH_CHECK(aclrtResetDevice(device_id));
    aclFinalize();
    return any_ok ? 0 : 1;
}
