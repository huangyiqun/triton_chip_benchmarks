/* Vector (AIV / SIMD VF) peak throughput for the Ascend 950DT.
 *
 * Measurement model, mirroring triton_chip_benchmarks/bench_vector.py: a fixed
 * number of independent accumulator chains live in vector registers and are
 * updated with a dependent multiply-add for ITERATIONS steps. Operands and
 * coefficients are loaded from UB before the loop, so the timed region issues
 * arithmetic only - no load/store traffic per update. Independent chains hide
 * the FMA result latency so the measured rate is the issue rate.
 *
 * Operation count = 2 * CHAINS * lanes * iterations * blocks (one multiply plus
 * one add per update). FLOP/s for floats, OP/s for INT8.
 *
 * Arithmetic precision honesty - what this architecture actually provides:
 *   fp32, fp16       native asc_fma (fused multiply-add) on the matching
 *                    vector type; the loop state keeps that type.
 *   bf16             native asc_fma on vector_bfloat16_t.
 *   int8             the RegBase vector ISA has asc_add for vector_int8_t but
 *                    NO asc_mul, so a native 8-bit multiply does not exist.
 *                    INT8 therefore runs as a widened multiply-add: operands
 *                    are INT8, the product is formed in INT16 and the state is
 *                    rounded back to INT8 each update. This is reported as
 *                    arithmetic_kind "widened_int16" - it is not a native INT8
 *                    vector multiply rate.
 *   fp8, fp4         the vector ISA provides conversion and data movement for
 *                    these types but no arithmetic at all. They are measured
 *                    as a convert-compute-convert chain: unpack to bf16, one
 *                    native bf16 FMA, pack back to the narrow type, with the
 *                    narrow type as the loop-carried state. This is reported
 *                    as arithmetic_kind "converted_bf16" and is explicitly NOT
 *                    a native FP8/FP4 vector arithmetic peak, because the
 *                    hardware has no such instruction. The conversions are
 *                    counted as overhead, not as operations: only the FMA's 2
 *                    operations per update are counted.
 *
 * Correctness: every configuration is validated against a host reference
 * computed with the same recurrence before it is timed.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include "bench_common.h"

/* Independent accumulator chains.
 *
 * Twelve is the measured knee on this architecture: the rate climbs from 12.22
 * TFLOP/s at 6 chains to 12.80 at 12 (FP32, against a 13.52 TFLOP/s ceiling of
 * 64 AIV x 1650 MHz x 64 lanes x 2), and 16 or more chains spill the 6144-byte
 * VF stack and collapse to a third of that. */
#define CHAINS 12

/* ============================ device kernels ============================= */

/* Each kernel keeps CHAINS vector registers live across the loop and updates
 * each as x = fma(x, a, b_i) with distinct per-chain b_i, so no two chains are
 * common-subexpression-merged. All chains are stored at the end, which is what
 * keeps the compiler from deleting the loop.
 *
 * UNROLL groups several updates per loop iteration to amortize loop control.
 */

/* FP32 chains: native asc_madd, which computes x = x * a + b in place.
 * The in-place form matters: the returning asc_fma spelling of the same
 * recurrence measures 6.85 TFLOP/s against 12.80 here, because it costs an
 * extra register move per update */
__simd_vf__ inline void vf_fp32(__ubuf__ float* state,
                               __ubuf__ float* coefficients,
                               __ubuf__ float* output, uint32_t iterations) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(float));
    /* asc_update_mask_b32/b16 take the remaining element count by reference
     * and consume one register's worth per call, so priming the counter with
     * exactly one register of lanes yields a full-register mask. */
    uint32_t mask_counter = lanes;
    vector_bool mask = asc_update_mask_b32(mask_counter);
    vector_float x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11;
    vector_float b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11;
    vector_float a;
    asc_load(a, coefficients);
    asc_load(x0, state + 0 * lanes);
    asc_load(b0, coefficients + 1 * lanes);
    asc_load(x1, state + 1 * lanes);
    asc_load(b1, coefficients + 2 * lanes);
    asc_load(x2, state + 2 * lanes);
    asc_load(b2, coefficients + 3 * lanes);
    asc_load(x3, state + 3 * lanes);
    asc_load(b3, coefficients + 4 * lanes);
    asc_load(x4, state + 4 * lanes);
    asc_load(b4, coefficients + 5 * lanes);
    asc_load(x5, state + 5 * lanes);
    asc_load(b5, coefficients + 6 * lanes);
    asc_load(x6, state + 6 * lanes);
    asc_load(b6, coefficients + 7 * lanes);
    asc_load(x7, state + 7 * lanes);
    asc_load(b7, coefficients + 8 * lanes);
    asc_load(x8, state + 8 * lanes);
    asc_load(b8, coefficients + 9 * lanes);
    asc_load(x9, state + 9 * lanes);
    asc_load(b9, coefficients + 10 * lanes);
    asc_load(x10, state + 10 * lanes);
    asc_load(b10, coefficients + 11 * lanes);
    asc_load(x11, state + 11 * lanes);
    asc_load(b11, coefficients + 12 * lanes);
    for (uint32_t i = 0; i < iterations; ++i) {
        asc_madd(x0, a, b0, mask);
        asc_madd(x1, a, b1, mask);
        asc_madd(x2, a, b2, mask);
        asc_madd(x3, a, b3, mask);
        asc_madd(x4, a, b4, mask);
        asc_madd(x5, a, b5, mask);
        asc_madd(x6, a, b6, mask);
        asc_madd(x7, a, b7, mask);
        asc_madd(x8, a, b8, mask);
        asc_madd(x9, a, b9, mask);
        asc_madd(x10, a, b10, mask);
        asc_madd(x11, a, b11, mask);
    }
    asc_store(output + 0 * lanes, x0);
    asc_store(output + 1 * lanes, x1);
    asc_store(output + 2 * lanes, x2);
    asc_store(output + 3 * lanes, x3);
    asc_store(output + 4 * lanes, x4);
    asc_store(output + 5 * lanes, x5);
    asc_store(output + 6 * lanes, x6);
    asc_store(output + 7 * lanes, x7);
    asc_store(output + 8 * lanes, x8);
    asc_store(output + 9 * lanes, x9);
    asc_store(output + 10 * lanes, x10);
    asc_store(output + 11 * lanes, x11);
}

/* FP16 chains: native 16-bit asc_madd */
__simd_vf__ inline void vf_fp16(__ubuf__ half* state,
                               __ubuf__ half* coefficients,
                               __ubuf__ half* output, uint32_t iterations) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(half));
    /* asc_update_mask_b32/b16 take the remaining element count by reference
     * and consume one register's worth per call, so priming the counter with
     * exactly one register of lanes yields a full-register mask. */
    uint32_t mask_counter = lanes;
    vector_bool mask = asc_update_mask_b16(mask_counter);
    vector_half x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11;
    vector_half b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11;
    vector_half a;
    asc_load(a, coefficients);
    asc_load(x0, state + 0 * lanes);
    asc_load(b0, coefficients + 1 * lanes);
    asc_load(x1, state + 1 * lanes);
    asc_load(b1, coefficients + 2 * lanes);
    asc_load(x2, state + 2 * lanes);
    asc_load(b2, coefficients + 3 * lanes);
    asc_load(x3, state + 3 * lanes);
    asc_load(b3, coefficients + 4 * lanes);
    asc_load(x4, state + 4 * lanes);
    asc_load(b4, coefficients + 5 * lanes);
    asc_load(x5, state + 5 * lanes);
    asc_load(b5, coefficients + 6 * lanes);
    asc_load(x6, state + 6 * lanes);
    asc_load(b6, coefficients + 7 * lanes);
    asc_load(x7, state + 7 * lanes);
    asc_load(b7, coefficients + 8 * lanes);
    asc_load(x8, state + 8 * lanes);
    asc_load(b8, coefficients + 9 * lanes);
    asc_load(x9, state + 9 * lanes);
    asc_load(b9, coefficients + 10 * lanes);
    asc_load(x10, state + 10 * lanes);
    asc_load(b10, coefficients + 11 * lanes);
    asc_load(x11, state + 11 * lanes);
    asc_load(b11, coefficients + 12 * lanes);
    for (uint32_t i = 0; i < iterations; ++i) {
        asc_madd(x0, a, b0, mask);
        asc_madd(x1, a, b1, mask);
        asc_madd(x2, a, b2, mask);
        asc_madd(x3, a, b3, mask);
        asc_madd(x4, a, b4, mask);
        asc_madd(x5, a, b5, mask);
        asc_madd(x6, a, b6, mask);
        asc_madd(x7, a, b7, mask);
        asc_madd(x8, a, b8, mask);
        asc_madd(x9, a, b9, mask);
        asc_madd(x10, a, b10, mask);
        asc_madd(x11, a, b11, mask);
    }
    asc_store(output + 0 * lanes, x0);
    asc_store(output + 1 * lanes, x1);
    asc_store(output + 2 * lanes, x2);
    asc_store(output + 3 * lanes, x3);
    asc_store(output + 4 * lanes, x4);
    asc_store(output + 5 * lanes, x5);
    asc_store(output + 6 * lanes, x6);
    asc_store(output + 7 * lanes, x7);
    asc_store(output + 8 * lanes, x8);
    asc_store(output + 9 * lanes, x9);
    asc_store(output + 10 * lanes, x10);
    asc_store(output + 11 * lanes, x11);
}

/* BF16 chains: native bfloat16 asc_madd */
__simd_vf__ inline void vf_bf16(__ubuf__ bfloat16_t* state,
                               __ubuf__ bfloat16_t* coefficients,
                               __ubuf__ bfloat16_t* output, uint32_t iterations) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(bfloat16_t));
    /* asc_update_mask_b32/b16 take the remaining element count by reference
     * and consume one register's worth per call, so priming the counter with
     * exactly one register of lanes yields a full-register mask. */
    uint32_t mask_counter = lanes;
    vector_bool mask = asc_update_mask_b16(mask_counter);
    vector_bfloat16_t x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11;
    vector_bfloat16_t b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11;
    vector_bfloat16_t a;
    asc_load(a, coefficients);
    asc_load(x0, state + 0 * lanes);
    asc_load(b0, coefficients + 1 * lanes);
    asc_load(x1, state + 1 * lanes);
    asc_load(b1, coefficients + 2 * lanes);
    asc_load(x2, state + 2 * lanes);
    asc_load(b2, coefficients + 3 * lanes);
    asc_load(x3, state + 3 * lanes);
    asc_load(b3, coefficients + 4 * lanes);
    asc_load(x4, state + 4 * lanes);
    asc_load(b4, coefficients + 5 * lanes);
    asc_load(x5, state + 5 * lanes);
    asc_load(b5, coefficients + 6 * lanes);
    asc_load(x6, state + 6 * lanes);
    asc_load(b6, coefficients + 7 * lanes);
    asc_load(x7, state + 7 * lanes);
    asc_load(b7, coefficients + 8 * lanes);
    asc_load(x8, state + 8 * lanes);
    asc_load(b8, coefficients + 9 * lanes);
    asc_load(x9, state + 9 * lanes);
    asc_load(b9, coefficients + 10 * lanes);
    asc_load(x10, state + 10 * lanes);
    asc_load(b10, coefficients + 11 * lanes);
    asc_load(x11, state + 11 * lanes);
    asc_load(b11, coefficients + 12 * lanes);
    for (uint32_t i = 0; i < iterations; ++i) {
        asc_madd(x0, a, b0, mask);
        asc_madd(x1, a, b1, mask);
        asc_madd(x2, a, b2, mask);
        asc_madd(x3, a, b3, mask);
        asc_madd(x4, a, b4, mask);
        asc_madd(x5, a, b5, mask);
        asc_madd(x6, a, b6, mask);
        asc_madd(x7, a, b7, mask);
        asc_madd(x8, a, b8, mask);
        asc_madd(x9, a, b9, mask);
        asc_madd(x10, a, b10, mask);
        asc_madd(x11, a, b11, mask);
    }
    asc_store(output + 0 * lanes, x0);
    asc_store(output + 1 * lanes, x1);
    asc_store(output + 2 * lanes, x2);
    asc_store(output + 3 * lanes, x3);
    asc_store(output + 4 * lanes, x4);
    asc_store(output + 5 * lanes, x5);
    asc_store(output + 6 * lanes, x6);
    asc_store(output + 7 * lanes, x7);
    asc_store(output + 8 * lanes, x8);
    asc_store(output + 9 * lanes, x9);
    asc_store(output + 10 * lanes, x10);
    asc_store(output + 11 * lanes, x11);
}

/* INT16 chains, used to measure INT8 operands.
 *
 * The vector ISA has asc_add for vector_int8_t but no 8-bit asc_mul, and there
 * is no integer asc_madd at all, so the update is a separate multiply and add
 * in INT16: one multiply plus one add per update, matching the float chains'
 * operation count. */
__simd_vf__ inline void vf_int16(__ubuf__ int16_t* state,
                               __ubuf__ int16_t* coefficients,
                               __ubuf__ int16_t* output, uint32_t iterations) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(int16_t));
    uint32_t mask_counter = lanes;
    vector_bool mask = asc_update_mask_b16(mask_counter);
    vector_int16_t x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11;
    vector_int16_t b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11;
    vector_int16_t a;
    asc_load(a, coefficients);
    asc_load(x0, state + 0 * lanes);
    asc_load(b0, coefficients + 1 * lanes);
    asc_load(x1, state + 1 * lanes);
    asc_load(b1, coefficients + 2 * lanes);
    asc_load(x2, state + 2 * lanes);
    asc_load(b2, coefficients + 3 * lanes);
    asc_load(x3, state + 3 * lanes);
    asc_load(b3, coefficients + 4 * lanes);
    asc_load(x4, state + 4 * lanes);
    asc_load(b4, coefficients + 5 * lanes);
    asc_load(x5, state + 5 * lanes);
    asc_load(b5, coefficients + 6 * lanes);
    asc_load(x6, state + 6 * lanes);
    asc_load(b6, coefficients + 7 * lanes);
    asc_load(x7, state + 7 * lanes);
    asc_load(b7, coefficients + 8 * lanes);
    asc_load(x8, state + 8 * lanes);
    asc_load(b8, coefficients + 9 * lanes);
    asc_load(x9, state + 9 * lanes);
    asc_load(b9, coefficients + 10 * lanes);
    asc_load(x10, state + 10 * lanes);
    asc_load(b10, coefficients + 11 * lanes);
    asc_load(x11, state + 11 * lanes);
    asc_load(b11, coefficients + 12 * lanes);
    for (uint32_t i = 0; i < iterations; ++i) {
        asc_mul(x0, x0, a, mask); asc_add(x0, x0, b0, mask);
        asc_mul(x1, x1, a, mask); asc_add(x1, x1, b1, mask);
        asc_mul(x2, x2, a, mask); asc_add(x2, x2, b2, mask);
        asc_mul(x3, x3, a, mask); asc_add(x3, x3, b3, mask);
        asc_mul(x4, x4, a, mask); asc_add(x4, x4, b4, mask);
        asc_mul(x5, x5, a, mask); asc_add(x5, x5, b5, mask);
        asc_mul(x6, x6, a, mask); asc_add(x6, x6, b6, mask);
        asc_mul(x7, x7, a, mask); asc_add(x7, x7, b7, mask);
        asc_mul(x8, x8, a, mask); asc_add(x8, x8, b8, mask);
        asc_mul(x9, x9, a, mask); asc_add(x9, x9, b9, mask);
        asc_mul(x10, x10, a, mask); asc_add(x10, x10, b10, mask);
        asc_mul(x11, x11, a, mask); asc_add(x11, x11, b11, mask);
    }
    asc_store(output + 0 * lanes, x0);
    asc_store(output + 1 * lanes, x1);
    asc_store(output + 2 * lanes, x2);
    asc_store(output + 3 * lanes, x3);
    asc_store(output + 4 * lanes, x4);
    asc_store(output + 5 * lanes, x5);
    asc_store(output + 6 * lanes, x6);
    asc_store(output + 7 * lanes, x7);
    asc_store(output + 8 * lanes, x8);
    asc_store(output + 9 * lanes, x9);
    asc_store(output + 10 * lanes, x10);
    asc_store(output + 11 * lanes, x11);
}

/* FP8 (E4M3) chains.
 *
 * The vector ISA has no FP8 arithmetic instruction, only FP8 conversion and
 * data movement, so the only way to run an FP8-typed multiply-add is to widen
 * to FP32, issue the native madd, and narrow back. The loop-carried state
 * stays FP8, so every update performs one real FP8 rounding.
 *
 * The two conversions are hardware instructions on the same vector pipeline
 * and are counted as overhead, not as operations: only the madd's 2 operations
 * per update enter the reported rate. That makes this a pipeline rate with FP8
 * operands, NOT a native FP8 vector arithmetic peak - no such instruction
 * exists on this chip. The Cube matrix unit does execute FP8 natively. */
__simd_vf__ inline void vf_fp8(__ubuf__ fp8_e4m3fn_t* state,
                               __ubuf__ fp8_e4m3fn_t* coefficients,
                               __ubuf__ fp8_e4m3fn_t* output, uint32_t iterations) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(float));
    /* A narrow register holds asc_get_vf_len() bytes and both the load and the
     * store move all of them, so each chain occupies a whole register slot.
     *
     * ASC_DISPERSE_FIRST_QUARTER does not mean "the leading quarter": the
     * conversion instructions interleave, so FP32 lane i corresponds to narrow
     * byte 4*i (measured: a converted value lands at byte offsets 0, 4, 8, ...
     * 252). The host builds the operands on that same stride. */
    const uint16_t slot = (uint16_t)asc_get_vf_len();
    uint32_t mask_counter = lanes;
    vector_bool mask = asc_update_mask_b32(mask_counter);
    vector_fp8_e4m3fn_t s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11;
    vector_fp8_e4m3fn_t cb0, cb1, cb2, cb3, cb4, cb5, cb6, cb7, cb8, cb9, cb10, cb11;
    vector_fp8_e4m3fn_t ca;
    asc_load(ca, coefficients);
    asc_load(s0, state + 0 * slot);
    asc_load(cb0, coefficients + 1 * slot);
    asc_load(s1, state + 1 * slot);
    asc_load(cb1, coefficients + 2 * slot);
    asc_load(s2, state + 2 * slot);
    asc_load(cb2, coefficients + 3 * slot);
    asc_load(s3, state + 3 * slot);
    asc_load(cb3, coefficients + 4 * slot);
    asc_load(s4, state + 4 * slot);
    asc_load(cb4, coefficients + 5 * slot);
    asc_load(s5, state + 5 * slot);
    asc_load(cb5, coefficients + 6 * slot);
    asc_load(s6, state + 6 * slot);
    asc_load(cb6, coefficients + 7 * slot);
    asc_load(s7, state + 7 * slot);
    asc_load(cb7, coefficients + 8 * slot);
    asc_load(s8, state + 8 * slot);
    asc_load(cb8, coefficients + 9 * slot);
    asc_load(s9, state + 9 * slot);
    asc_load(cb9, coefficients + 10 * slot);
    asc_load(s10, state + 10 * slot);
    asc_load(cb10, coefficients + 11 * slot);
    asc_load(s11, state + 11 * slot);
    asc_load(cb11, coefficients + 12 * slot);
    /* The loop-invariant coefficients are widened once, here, so the
     * timed loop carries only the per-update conversions. */
    vector_float a = asc_e4m32float(ca, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b0 = asc_e4m32float(cb0, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b1 = asc_e4m32float(cb1, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b2 = asc_e4m32float(cb2, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b3 = asc_e4m32float(cb3, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b4 = asc_e4m32float(cb4, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b5 = asc_e4m32float(cb5, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b6 = asc_e4m32float(cb6, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b7 = asc_e4m32float(cb7, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b8 = asc_e4m32float(cb8, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b9 = asc_e4m32float(cb9, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b10 = asc_e4m32float(cb10, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_float b11 = asc_e4m32float(cb11, mask, ASC_DISPERSE_FIRST_QUARTER);
    for (uint32_t i = 0; i < iterations; ++i) {
        vector_float w0 = asc_e4m32float(s0, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w0, a, b0, mask);
        s0 = asc_float2e4m3_rn(w0, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w1 = asc_e4m32float(s1, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w1, a, b1, mask);
        s1 = asc_float2e4m3_rn(w1, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w2 = asc_e4m32float(s2, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w2, a, b2, mask);
        s2 = asc_float2e4m3_rn(w2, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w3 = asc_e4m32float(s3, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w3, a, b3, mask);
        s3 = asc_float2e4m3_rn(w3, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w4 = asc_e4m32float(s4, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w4, a, b4, mask);
        s4 = asc_float2e4m3_rn(w4, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w5 = asc_e4m32float(s5, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w5, a, b5, mask);
        s5 = asc_float2e4m3_rn(w5, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w6 = asc_e4m32float(s6, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w6, a, b6, mask);
        s6 = asc_float2e4m3_rn(w6, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w7 = asc_e4m32float(s7, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w7, a, b7, mask);
        s7 = asc_float2e4m3_rn(w7, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w8 = asc_e4m32float(s8, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w8, a, b8, mask);
        s8 = asc_float2e4m3_rn(w8, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w9 = asc_e4m32float(s9, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w9, a, b9, mask);
        s9 = asc_float2e4m3_rn(w9, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w10 = asc_e4m32float(s10, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w10, a, b10, mask);
        s10 = asc_float2e4m3_rn(w10, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_float w11 = asc_e4m32float(s11, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w11, a, b11, mask);
        s11 = asc_float2e4m3_rn(w11, mask, ASC_DISPERSE_FIRST_QUARTER);
    }
    asc_store(output + 0 * slot, s0);
    asc_store(output + 1 * slot, s1);
    asc_store(output + 2 * slot, s2);
    asc_store(output + 3 * slot, s3);
    asc_store(output + 4 * slot, s4);
    asc_store(output + 5 * slot, s5);
    asc_store(output + 6 * slot, s6);
    asc_store(output + 7 * slot, s7);
    asc_store(output + 8 * slot, s8);
    asc_store(output + 9 * slot, s9);
    asc_store(output + 10 * slot, s10);
    asc_store(output + 11 * slot, s11);
}

/* FP4 (E2M1) chains.
 *
 * Same situation as FP8, for the same reason: the vector ISA offers FP4
 * conversion and movement but no FP4 arithmetic. The widening partner here is
 * BF16, which is what the FP4 conversion instructions target. The state stays
 * FP4, so every update rounds back onto the 8-magnitude E2M1 lattice. Only the
 * madd's 2 operations per update are counted, so this is likewise not a native
 * FP4 vector arithmetic peak; the Cube matrix unit does execute FP4 natively
 * through asc_mmad_mx. */
__simd_vf__ inline void vf_fp4(__ubuf__ fp4x2_e2m1_t* state,
                               __ubuf__ fp4x2_e2m1_t* coefficients,
                               __ubuf__ fp4x2_e2m1_t* output, uint32_t iterations) {
    const uint16_t lanes = (uint16_t)(asc_get_vf_len() / sizeof(bfloat16_t));
    /* A narrow register holds asc_get_vf_len() bytes and both the load and the
     * store move all of them, so each chain occupies a whole register slot.
     *
     * ASC_DISPERSE_FIRST_QUARTER does not mean "the leading quarter": the
     * conversion instructions interleave, so FP32 lane i corresponds to narrow
     * byte 4*i (measured: a converted value lands at byte offsets 0, 4, 8, ...
     * 252). The host builds the operands on that same stride. */
    const uint16_t slot = (uint16_t)asc_get_vf_len();
    uint32_t mask_counter = lanes;
    vector_bool mask = asc_update_mask_b16(mask_counter);
    vector_fp4x2_e2m1_t s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11;
    vector_fp4x2_e2m1_t cb0, cb1, cb2, cb3, cb4, cb5, cb6, cb7, cb8, cb9, cb10, cb11;
    vector_fp4x2_e2m1_t ca;
    asc_load(ca, coefficients);
    asc_load(s0, state + 0 * slot);
    asc_load(cb0, coefficients + 1 * slot);
    asc_load(s1, state + 1 * slot);
    asc_load(cb1, coefficients + 2 * slot);
    asc_load(s2, state + 2 * slot);
    asc_load(cb2, coefficients + 3 * slot);
    asc_load(s3, state + 3 * slot);
    asc_load(cb3, coefficients + 4 * slot);
    asc_load(s4, state + 4 * slot);
    asc_load(cb4, coefficients + 5 * slot);
    asc_load(s5, state + 5 * slot);
    asc_load(cb5, coefficients + 6 * slot);
    asc_load(s6, state + 6 * slot);
    asc_load(cb6, coefficients + 7 * slot);
    asc_load(s7, state + 7 * slot);
    asc_load(cb7, coefficients + 8 * slot);
    asc_load(s8, state + 8 * slot);
    asc_load(cb8, coefficients + 9 * slot);
    asc_load(s9, state + 9 * slot);
    asc_load(cb9, coefficients + 10 * slot);
    asc_load(s10, state + 10 * slot);
    asc_load(cb10, coefficients + 11 * slot);
    asc_load(s11, state + 11 * slot);
    asc_load(cb11, coefficients + 12 * slot);
    /* The loop-invariant coefficients are widened once, here, so the
     * timed loop carries only the per-update conversions. */
    vector_bfloat16_t a = asc_e2m1x22bfloat16(ca, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b0 = asc_e2m1x22bfloat16(cb0, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b1 = asc_e2m1x22bfloat16(cb1, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b2 = asc_e2m1x22bfloat16(cb2, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b3 = asc_e2m1x22bfloat16(cb3, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b4 = asc_e2m1x22bfloat16(cb4, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b5 = asc_e2m1x22bfloat16(cb5, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b6 = asc_e2m1x22bfloat16(cb6, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b7 = asc_e2m1x22bfloat16(cb7, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b8 = asc_e2m1x22bfloat16(cb8, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b9 = asc_e2m1x22bfloat16(cb9, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b10 = asc_e2m1x22bfloat16(cb10, mask, ASC_DISPERSE_FIRST_QUARTER);
    vector_bfloat16_t b11 = asc_e2m1x22bfloat16(cb11, mask, ASC_DISPERSE_FIRST_QUARTER);
    for (uint32_t i = 0; i < iterations; ++i) {
        vector_bfloat16_t w0 = asc_e2m1x22bfloat16(s0, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w0, a, b0, mask);
        s0 = asc_bfloat162e2m1x2_rn(w0, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w1 = asc_e2m1x22bfloat16(s1, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w1, a, b1, mask);
        s1 = asc_bfloat162e2m1x2_rn(w1, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w2 = asc_e2m1x22bfloat16(s2, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w2, a, b2, mask);
        s2 = asc_bfloat162e2m1x2_rn(w2, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w3 = asc_e2m1x22bfloat16(s3, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w3, a, b3, mask);
        s3 = asc_bfloat162e2m1x2_rn(w3, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w4 = asc_e2m1x22bfloat16(s4, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w4, a, b4, mask);
        s4 = asc_bfloat162e2m1x2_rn(w4, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w5 = asc_e2m1x22bfloat16(s5, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w5, a, b5, mask);
        s5 = asc_bfloat162e2m1x2_rn(w5, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w6 = asc_e2m1x22bfloat16(s6, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w6, a, b6, mask);
        s6 = asc_bfloat162e2m1x2_rn(w6, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w7 = asc_e2m1x22bfloat16(s7, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w7, a, b7, mask);
        s7 = asc_bfloat162e2m1x2_rn(w7, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w8 = asc_e2m1x22bfloat16(s8, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w8, a, b8, mask);
        s8 = asc_bfloat162e2m1x2_rn(w8, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w9 = asc_e2m1x22bfloat16(s9, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w9, a, b9, mask);
        s9 = asc_bfloat162e2m1x2_rn(w9, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w10 = asc_e2m1x22bfloat16(s10, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w10, a, b10, mask);
        s10 = asc_bfloat162e2m1x2_rn(w10, mask, ASC_DISPERSE_FIRST_QUARTER);
        vector_bfloat16_t w11 = asc_e2m1x22bfloat16(s11, mask, ASC_DISPERSE_FIRST_QUARTER);
        asc_madd(w11, a, b11, mask);
        s11 = asc_bfloat162e2m1x2_rn(w11, mask, ASC_DISPERSE_FIRST_QUARTER);
    }
    asc_store(output + 0 * slot, s0);
    asc_store(output + 1 * slot, s1);
    asc_store(output + 2 * slot, s2);
    asc_store(output + 3 * slot, s3);
    asc_store(output + 4 * slot, s4);
    asc_store(output + 5 * slot, s5);
    asc_store(output + 6 * slot, s6);
    asc_store(output + 7 * slot, s7);
    asc_store(output + 8 * slot, s8);
    asc_store(output + 9 * slot, s9);
    asc_store(output + 10 * slot, s10);
    asc_store(output + 11 * slot, s11);
}

/* Kernel wrapper.
 *
 * One kernel per translation unit, selected by -DBENCH_VECTOR_DTYPE, with
 * local UB declarations. Sharing one file-scope UB pool across several kernels
 * through casts produced nondeterministic results here and pathological
 * compile times in the Cube benchmark, so each binary carries exactly the one
 * chain set it measures.
 *
 * UB use is (3 * CHAINS + 1) register-widths, far inside the 216 KiB per
 * vector core this device reports. */
#define VECTOR_FP32 1
#define VECTOR_FP16 2
#define VECTOR_BF16 3
#define VECTOR_INT8 4
#define VECTOR_FP8  5
#define VECTOR_FP4  6

#ifndef BENCH_VECTOR_DTYPE
#error "define BENCH_VECTOR_DTYPE to one of VECTOR_FP32..VECTOR_FP4"
#endif

#if BENCH_VECTOR_DTYPE == VECTOR_FP32
  #define STATE_T     float
  #define CHAIN_VF    vf_fp32
  #define DTYPE_NAME  "fp32"
  #define LANE_BYTES  4u          /* arithmetic lane width: native FP32 FMA */
#elif BENCH_VECTOR_DTYPE == VECTOR_FP16
  #define STATE_T     half
  #define CHAIN_VF    vf_fp16
  #define DTYPE_NAME  "fp16"
  #define LANE_BYTES  2u
#elif BENCH_VECTOR_DTYPE == VECTOR_BF16
  #define STATE_T     bfloat16_t
  #define CHAIN_VF    vf_bf16
  #define DTYPE_NAME  "bf16"
  #define LANE_BYTES  2u
#elif BENCH_VECTOR_DTYPE == VECTOR_INT8
  /* INT8 operands carried in INT16 lanes: the vector ISA has asc_add for
   * vector_int8_t but no 8-bit asc_mul, so there is no native INT8 multiply. */
  #define STATE_T     int16_t
  #define CHAIN_VF    vf_int16
  #define DTYPE_NAME  "int8"
  #define LANE_BYTES  2u
#elif BENCH_VECTOR_DTYPE == VECTOR_FP8
  #define STATE_T     fp8_e4m3fn_t
  #define CHAIN_VF    vf_fp8
  #define DTYPE_NAME  "fp8"
  #define LANE_BYTES  4u          /* the FMA runs on its FP32 partner */
#elif BENCH_VECTOR_DTYPE == VECTOR_FP4
  #define STATE_T     fp4x2_e2m1_t
  #define CHAIN_VF    vf_fp4
  #define DTYPE_NAME  "fp4"
  #define LANE_BYTES  2u          /* the FMA runs on its BF16 partner */
#else
  #error "unknown BENCH_VECTOR_DTYPE"
#endif

/* Register width in bytes; 256 on this architecture. One register's worth of
 * state per chain, plus one shared multiplier and one bias per chain. */
#define REGISTER_BYTES 256u

__vector__ __global__ void vector_chains(__gm__ STATE_T* state_in,
                                         __gm__ STATE_T* coefficients_in,
                                         __gm__ STATE_T* output_out,
                                         uint32_t iterations,
                                         uint32_t state_bytes,
                                         uint32_t coefficient_bytes) {
    asc_init();
    __ubuf__ STATE_T state[CHAINS * REGISTER_BYTES];
    __ubuf__ STATE_T coefficients[(CHAINS + 1) * REGISTER_BYTES];
    __ubuf__ STATE_T output[CHAINS * REGISTER_BYTES];
    asc_copy_gm2ub(state, state_in, state_bytes);
    asc_copy_gm2ub(coefficients, coefficients_in, coefficient_bytes);
    asc_sync();
    asc_vf_call<CHAIN_VF>((__ubuf__ STATE_T*)state, (__ubuf__ STATE_T*)coefficients,
                          (__ubuf__ STATE_T*)output, iterations);
    asc_sync();
    asc_copy_ub2gm(output_out + (uint64_t)block_idx * (state_bytes / sizeof(STATE_T)),
                   output, state_bytes);
    asc_sync();
}

/* ============================== host driver ============================== */

/* This binary measures exactly the dtype it was compiled for. */
static const char* const kDtypeName = DTYPE_NAME;

#if BENCH_VECTOR_DTYPE == VECTOR_INT8
  static const int kIntegerMetric = 1;
#else
  static const int kIntegerMetric = 0;
#endif

#if BENCH_VECTOR_DTYPE == VECTOR_FP32 || BENCH_VECTOR_DTYPE == VECTOR_FP16 \
    || BENCH_VECTOR_DTYPE == VECTOR_BF16
  static const int kNativeArithmetic = 1;
#else
  static const int kNativeArithmetic = 0;
#endif

typedef struct {
    uint32_t blocks, iterations, lanes;
    uint32_t state_bytes, coefficient_bytes;
    void *state, *coefficients, *output;
    aclrtStream stream;
} vector_context;

static void vector_launch(void* opaque) {
    vector_context* context = (vector_context*)opaque;
    vector_chains<<<context->blocks, 0, context->stream>>>(
        (__gm__ STATE_T*)context->state, (__gm__ STATE_T*)context->coefficients,
        (__gm__ STATE_T*)context->output, context->iterations,
        context->state_bytes, context->coefficient_bytes);
}

int main(int argc, char** argv) {
    int32_t device_id = 0;
    const char* dtype_argument = DTYPE_NAME;
    uint32_t iterations = 4096;
    const char* output_path = NULL;
    int quick = 0;

    for (int i = 1; i < argc; ++i) {
        if (!strcmp(argv[i], "--device") && i + 1 < argc) device_id = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--dtype") && i + 1 < argc) dtype_argument = argv[++i];
        else if (!strcmp(argv[i], "--iterations") && i + 1 < argc) iterations = (uint32_t)atoi(argv[++i]);
        else if (!strcmp(argv[i], "--output") && i + 1 < argc) output_path = argv[++i];
        else if (!strcmp(argv[i], "--quick")) quick = 1;
        else {
            fprintf(stderr, "usage: %s [--device N] [--dtype %s] "
                            "[--iterations N] [--output FILE] [--quick]\n", argv[0], DTYPE_NAME);
            return 2;
        }
    }

    /* Refuse a dtype this binary was not built for, rather than measuring one
     * format and labelling it another. */
    if (strcmp(dtype_argument, kDtypeName) != 0) {
        fprintf(stderr, "this binary measures %s, not %s; use bench_vector_%s\n",
                kDtypeName, dtype_argument, dtype_argument);
        return 2;
    }

    BENCH_CHECK(aclInit(NULL));
    BENCH_CHECK(aclrtSetDevice(device_id));
    aclrtStream stream = NULL;
    BENCH_CHECK(aclrtCreateStream(&stream));

    bench_device_info device;
    bench_query_device(device_id, &device);
    printf("Device %d: %s (arch %lld) | vector cores=%lld | UB=%lld KiB/core",
           (int)device_id, device.soc_name, (long long)device.npu_arch,
           (long long)device.vector_core_num,
           (long long)(device.ub_per_vector_core / 1024));
    if (device.aicore_freq_mhz > 0) printf(" | %.0f MHz", device.aicore_freq_mhz);
    printf("\n");

    FILE* output = output_path ? fopen(output_path, "w") : NULL;
    if (output_path && !output) { fprintf(stderr, "cannot write %s\n", output_path); return 1; }
    bench_json json;
    bench_json_init(&json, output ? output : stdout);

    const int integer_metric = kIntegerMetric;
    const char* unit = integer_metric ? "TOP/s" : "TFLOP/s";

    /* Element size of the arithmetic actually executed, and the honest
     * description of that arithmetic. */
    /* Storage width of the loop-carried state, and an honest description of
     * the arithmetic the hardware actually executes for this format. */
#if BENCH_VECTOR_DTYPE == VECTOR_FP32
    const size_t element_size = 4;
    const char* arithmetic_kind = "native_fp32_madd";
    const char* arithmetic_note =
        "native in-place asc_madd (x = x * a + b) on vector_float; FP32 state";
#elif BENCH_VECTOR_DTYPE == VECTOR_FP16
    const size_t element_size = 2;
    const char* arithmetic_kind = "native_fp16_madd";
    const char* arithmetic_note =
        "native in-place asc_madd on vector_half; FP16 state";
#elif BENCH_VECTOR_DTYPE == VECTOR_BF16
    const size_t element_size = 2;
    const char* arithmetic_kind = "native_bf16_madd";
    const char* arithmetic_note =
        "native in-place asc_madd on vector_bfloat16_t; BF16 state";
#elif BENCH_VECTOR_DTYPE == VECTOR_INT8
    const size_t element_size = 2;
    const char* arithmetic_kind = "widened_int16_mul_add";
    const char* arithmetic_note =
        "the vector ISA has asc_add for vector_int8_t but no 8-bit asc_mul, so "
        "INT8-range operands are multiplied and added in INT16; this is not a "
        "native INT8 vector multiply rate";
#elif BENCH_VECTOR_DTYPE == VECTOR_FP8
    const size_t element_size = 1;
    const char* arithmetic_kind = "converted_fp32_madd_fp8_state";
    const char* arithmetic_note =
        "the vector ISA has no FP8 arithmetic instruction, only FP8 conversion "
        "and movement, so each update converts FP8->FP32, issues a native FP32 "
        "FMA and converts back, keeping FP8 state; the conversions are overhead "
        "and are not counted, so this is a pipeline rate with FP8 operands, not "
        "a native FP8 vector peak";
#elif BENCH_VECTOR_DTYPE == VECTOR_FP4
    const size_t element_size = 1;   /* two elements per byte; see state_bytes */
    const char* arithmetic_kind = "converted_bf16_madd_fp4_state";
    const char* arithmetic_note =
        "the vector ISA has no FP4 arithmetic instruction, only FP4 conversion "
        "and movement, so each update converts FP4->BF16, issues a native BF16 "
        "FMA and converts back, keeping FP4 state; the conversions are overhead "
        "and are not counted, so this is a pipeline rate with FP4 operands, not "
        "a native FP4 vector peak";
#endif

    /* The vector register is 256 bytes. `lanes` is the number of accumulator
     * lanes the arithmetic actually computes on, which sets the operation
     * count. It differs from the state's storage width for FP8 and FP4, where
     * the state is narrow but the FMA runs on a wider partner type and so
     * covers fewer lanes per register. */
    const uint32_t lanes = REGISTER_BYTES / LANE_BYTES;

    const uint32_t cores = (uint32_t)device.vector_core_num;
    if (cores == 0) {
        fprintf(stderr, "[FATAL] the runtime reported no vector core count\n");
        return 1;
    }

    uint32_t blocks_per_core_values[4] = {1, 2, 4, 8};
    int blocks_per_core_count = quick ? 1 : 4;
    if (quick) iterations = 256;

    printf("\nVector peak: %s, %d independent chains, %u iterations, %u lanes/register\n",
           kDtypeName, CHAINS, iterations, lanes);
    printf("Arithmetic: %s\n", arithmetic_note);
    printf("Operations = 2 * %d chains * %u lanes * iterations * blocks\n", CHAINS, lanes);
    printf("  blocks  median ms     min ms   median %-8s  peak %-8s  check\n", unit, unit);

    if (output) {
        bench_json_begin_document(&json);
        bench_json_string(&json, "benchmark", "vector_peak");
        bench_json_string(&json, "dtype", kDtypeName);
        bench_json_string(&json, "unit", unit);
        bench_json_int(&json, "chains", CHAINS);
        bench_json_int(&json, "lanes_per_register", lanes);
        bench_json_int(&json, "iterations", iterations);
        bench_json_string(&json, "arithmetic_kind", arithmetic_kind);
        bench_json_string(&json, "arithmetic_note", arithmetic_note);
        bench_json_bool(&json, "native_arithmetic",
                        kNativeArithmetic);
        bench_json_string(&json, "operation_count_formula",
                          "2 * chains * lanes * iterations * blocks");
        bench_json_open_array(&json, "results");
    }

    double best_peak = -1.0, best_median = -1.0;
    uint32_t best_blocks = 0;
    int any_ok = 0;

    for (int bi = 0; bi < blocks_per_core_count; ++bi) {
        const uint32_t blocks = blocks_per_core_values[bi] * cores;
        const uint32_t state_elements = CHAINS * lanes;
        const uint32_t coefficient_elements = (CHAINS + 1) * lanes;
        /* FP4 stores two elements per byte; every other type is one per byte
         * of its element size. Round up so a byte is never shared across the
         * state/coefficient boundary. */
#if BENCH_VECTOR_DTYPE == VECTOR_FP8 || BENCH_VECTOR_DTYPE == VECTOR_FP4
        /* FP8 and FP4 move a whole narrow register per chain while the
         * arithmetic covers only its first quarter, so each chain gets a full
         * register slot with the live state in its leading `lanes` elements. */
        const size_t slot_bytes = REGISTER_BYTES;
        const size_t state_bytes = (size_t)CHAINS * slot_bytes;
        const size_t coefficient_bytes = (size_t)(CHAINS + 1) * slot_bytes;
#else
        const size_t state_bytes = (size_t)state_elements * element_size;
        const size_t coefficient_bytes = (size_t)coefficient_elements * element_size;
#endif
        const size_t output_bytes = (size_t)blocks * state_bytes;

        void* host_state = malloc(state_bytes);
        void* host_coefficients = malloc(coefficient_bytes);
        /* Host-side reference values, in double, for the validation recurrence. */
        double* reference_state = (double*)malloc((size_t)state_elements * sizeof(double));
        double* reference_a = (double*)malloc((size_t)lanes * sizeof(double));
        double* reference_b = (double*)malloc((size_t)state_elements * sizeof(double));

        /* Choose operands whose recurrence is exactly representable:
         *   float types: a = -1, so x alternates between x and b - x each step.
         *                Values are multiples of 1/8 so both states are exact.
         *   int16:       a = -1 likewise, with small integer biases. */
        for (uint32_t i = 0; i < state_elements; ++i) {
            double value = (double)((int)(i % 9u) - 4) / 8.0;
            reference_state[i] = value;
            double bias = (double)((int)(i % 7u) - 3) / 8.0;
            reference_b[i] = bias;
        }
        for (uint32_t i = 0; i < lanes; ++i) reference_a[i] = -1.0;

#if BENCH_VECTOR_DTYPE == VECTOR_FP32
        {
            float* state = (float*)host_state;
            float* coefficients = (float*)host_coefficients;
            for (uint32_t i = 0; i < state_elements; ++i) state[i] = (float)reference_state[i];
            for (uint32_t i = 0; i < lanes; ++i) coefficients[i] = (float)reference_a[i];
            for (uint32_t i = 0; i < state_elements; ++i)
                coefficients[lanes + i] = (float)reference_b[i];
        }
#elif BENCH_VECTOR_DTYPE == VECTOR_FP16
        {
            uint16_t* state = (uint16_t*)host_state;
            uint16_t* coefficients = (uint16_t*)host_coefficients;
            for (uint32_t i = 0; i < state_elements; ++i)
                state[i] = bench_float_to_fp16((float)reference_state[i]);
            for (uint32_t i = 0; i < lanes; ++i)
                coefficients[i] = bench_float_to_fp16((float)reference_a[i]);
            for (uint32_t i = 0; i < state_elements; ++i)
                coefficients[lanes + i] = bench_float_to_fp16((float)reference_b[i]);
        }
#elif BENCH_VECTOR_DTYPE == VECTOR_BF16
        {
            uint16_t* state = (uint16_t*)host_state;
            uint16_t* coefficients = (uint16_t*)host_coefficients;
            for (uint32_t i = 0; i < state_elements; ++i)
                state[i] = bench_float_to_bf16((float)reference_state[i]);
            for (uint32_t i = 0; i < lanes; ++i)
                coefficients[i] = bench_float_to_bf16((float)reference_a[i]);
            for (uint32_t i = 0; i < state_elements; ++i)
                coefficients[lanes + i] = bench_float_to_bf16((float)reference_b[i]);
        }
#elif BENCH_VECTOR_DTYPE == VECTOR_INT8
        {
            /* INT8-range operands carried in INT16 lanes. */
            int16_t* state = (int16_t*)host_state;
            int16_t* coefficients = (int16_t*)host_coefficients;
            for (uint32_t i = 0; i < state_elements; ++i) {
                reference_state[i] = (double)((int)(i % 9u) - 4);
                reference_b[i] = (double)((int)(i % 7u) - 3);
                state[i] = (int16_t)reference_state[i];
            }
            for (uint32_t i = 0; i < lanes; ++i) { reference_a[i] = -1.0; coefficients[i] = -1; }
            for (uint32_t i = 0; i < state_elements; ++i)
                coefficients[lanes + i] = (int16_t)reference_b[i];
        }
#elif BENCH_VECTOR_DTYPE == VECTOR_FP8
        {
            /* One FP8 element per byte; chain c lives at slot c, lane i. */
            uint8_t* state = (uint8_t*)host_state;
            uint8_t* coefficients = (uint8_t*)host_coefficients;
            memset(state, 0, state_bytes);
            memset(coefficients, 0, coefficient_bytes);
            /* FP32 lane i lives in narrow byte 4*i; see the kernel comment. */
            const uint32_t stride = 4;
            for (uint32_t chain = 0; chain < CHAINS; ++chain)
                for (uint32_t i = 0; i < lanes; ++i)
                    state[chain * slot_bytes + i * stride] =
                        bench_float_to_fp8_e4m3((float)reference_state[chain * lanes + i]);
            for (uint32_t i = 0; i < lanes; ++i)
                coefficients[i * stride] = bench_float_to_fp8_e4m3((float)reference_a[i]);
            for (uint32_t chain = 0; chain < CHAINS; ++chain)
                for (uint32_t i = 0; i < lanes; ++i)
                    coefficients[(chain + 1) * slot_bytes + i * stride] =
                        bench_float_to_fp8_e4m3((float)reference_b[chain * lanes + i]);
        }
#elif BENCH_VECTOR_DTYPE == VECTOR_FP4
        {
            /* FP4 packs two elements per byte, and chain c occupies slot c.
             * Values are restricted to the E2M1 lattice so the recurrence is
             * exactly representable and validation has zero tolerance. */
            uint8_t* state = (uint8_t*)host_state;
            uint8_t* coefficients = (uint8_t*)host_coefficients;
            memset(state, 0, state_bytes);
            memset(coefficients, 0, coefficient_bytes);
            for (uint32_t i = 0; i < state_elements; ++i) {
                reference_state[i] = (double)((int)(i % 5u) - 2) * 0.5;
                reference_b[i] = (double)((int)(i % 3u) - 1) * 0.5;
            }
            for (uint32_t i = 0; i < lanes; ++i) reference_a[i] = -1.0;
            /* The FP4 widening takes BOTH nibbles of every fourth byte:
             * measured, BF16 lane 2j comes from byte 4*j's low nibble and lane
             * 2j+1 from its high nibble. Writing a value at lane i therefore
             * means byte 4*(i/2), low nibble for even i and high for odd. */
            for (uint32_t chain = 0; chain < CHAINS; ++chain) {
                for (uint32_t i = 0; i < lanes; ++i) {
                    uint8_t code = bench_float_to_fp4_e2m1(
                        (float)reference_state[chain * lanes + i]);
                    size_t byte = chain * slot_bytes + 4u * (i / 2u);
                    if (i & 1u) state[byte] |= (uint8_t)(code << 4);
                    else        state[byte] |= code;
                }
            }
            for (uint32_t i = 0; i < lanes; ++i) {
                uint8_t code = bench_float_to_fp4_e2m1((float)reference_a[i]);
                size_t byte = 4u * (i / 2u);
                if (i & 1u) coefficients[byte] |= (uint8_t)(code << 4);
                else        coefficients[byte] |= code;
            }
            for (uint32_t chain = 0; chain < CHAINS; ++chain) {
                for (uint32_t i = 0; i < lanes; ++i) {
                    uint8_t code = bench_float_to_fp4_e2m1(
                        (float)reference_b[chain * lanes + i]);
                    size_t byte = (chain + 1) * slot_bytes + 4u * (i / 2u);
                    if (i & 1u) coefficients[byte] |= (uint8_t)(code << 4);
                    else        coefficients[byte] |= code;
                }
            }
        }
#endif

        void *device_state = NULL, *device_coefficients = NULL, *device_output = NULL;
        BENCH_CHECK(aclrtMalloc(&device_state, state_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        BENCH_CHECK(aclrtMalloc(&device_coefficients, coefficient_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        BENCH_CHECK(aclrtMalloc(&device_output, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        BENCH_CHECK(aclrtMemcpy(device_state, state_bytes, host_state, state_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        BENCH_CHECK(aclrtMemcpy(device_coefficients, coefficient_bytes, host_coefficients,
                                coefficient_bytes, ACL_MEMCPY_HOST_TO_DEVICE));

        vector_context context;
        context.blocks = blocks; context.iterations = iterations;
        context.lanes = lanes;
        context.state_bytes = (uint32_t)state_bytes;
        context.coefficient_bytes = (uint32_t)coefficient_bytes;
        context.state = device_state; context.coefficients = device_coefficients;
        context.output = device_output; context.stream = stream;

        /* ---- validate before timing ---- */
        BENCH_CHECK(aclrtMemset(device_output, output_bytes, 0xFF, output_bytes));
        vector_launch(&context);
        aclError launch_status = aclrtSynchronizeStream(stream);
        int validated = 0;
        double max_absolute_error = 0.0;
        if (launch_status != ACL_SUCCESS) {
            printf("%8u   launch failed: %d (%s)\n", blocks, (int)launch_status, aclGetRecentErrMsg());
        } else {
            void* host_output = malloc(output_bytes);
            BENCH_CHECK(aclrtMemcpy(host_output, output_bytes, device_output, output_bytes,
                                    ACL_MEMCPY_DEVICE_TO_HOST));
            validated = 1;
            /* Closed form for a = -1: after an even iteration count the state
             * returns to x, after an odd count it is b - x. */
            for (uint32_t i = 0; i < state_elements && validated; ++i) {
                double expected = (iterations % 2 == 0)
                    ? reference_state[i]
                    : reference_b[i] - reference_state[i];
                double observed;
#if BENCH_VECTOR_DTYPE == VECTOR_FP32
                observed = (double)((float*)host_output)[i];
#elif BENCH_VECTOR_DTYPE == VECTOR_FP16
                observed = (double)bench_fp16_to_float(((uint16_t*)host_output)[i]);
#elif BENCH_VECTOR_DTYPE == VECTOR_BF16
                observed = (double)bench_bf16_to_float(((uint16_t*)host_output)[i]);
#elif BENCH_VECTOR_DTYPE == VECTOR_INT8
                observed = (double)((int16_t*)host_output)[i];
#elif BENCH_VECTOR_DTYPE == VECTOR_FP8
                observed = (double)bench_fp8_e4m3_to_float(
                    ((uint8_t*)host_output)[(i / lanes) * slot_bytes + (i % lanes) * 4]);
#elif BENCH_VECTOR_DTYPE == VECTOR_FP4
                {
                    const uint32_t lane = i % lanes;
                    uint8_t byte = ((uint8_t*)host_output)[(i / lanes) * slot_bytes
                                                           + 4u * (lane / 2u)];
                    uint8_t nibble = (lane & 1u) ? (uint8_t)(byte >> 4)
                                                 : (uint8_t)(byte & 0x0Fu);
                    observed = (double)bench_fp4_e2m1_to_float(nibble);
                }
#endif
                double error = bench_fabs(observed - expected);
                if (error > max_absolute_error) max_absolute_error = error;
                if (error > 1e-6) {
                    printf("%8u   VALIDATION FAILED at chain element %u: got %.10g expected %.10g\n",
                           blocks, i, observed, expected);
                    validated = 0;
                }
            }
            /* Every block ran the identical chain set; all must agree. */
            if (validated) {
                for (uint32_t block = 1; block < blocks; ++block) {
                    const void* other = (const char*)host_output + (size_t)block * state_bytes;
                    if (memcmp(host_output, other, state_bytes) != 0) {
                        printf("%8u   VALIDATION FAILED: block %u differs from block 0\n", blocks, block);
                        validated = 0;
                        break;
                    }
                }
            }
            free(host_output);
        }

        if (validated) {
            bench_timing_config timing_config = bench_default_timing();
            if (quick) { timing_config.warmup_ms = 10; timing_config.rep_ms = 20; timing_config.rounds = 3; }
            bench_timing_result timing;
            if (bench_measure(vector_launch, &context, stream, &timing_config, &timing) == 0) {
                double operations = 2.0 * CHAINS * lanes * iterations * blocks;
                double peak = operations / (timing.min_ms * 1e9);
                double median = operations / (timing.median_ms * 1e9);
                printf("%8u  %10.5f %10.5f %17.3f %15.3f  exact\n",
                       blocks, timing.median_ms, timing.min_ms, median, peak);
                fflush(stdout);
                any_ok = 1;
                if (peak > best_peak) { best_peak = peak; best_median = median; best_blocks = blocks; }
                if (output) {
                    bench_json_open_object(&json, NULL);
                    bench_json_int(&json, "blocks", blocks);
                    bench_json_int(&json, "blocks_per_core", blocks / cores);
                    bench_json_int(&json, "iterations", iterations);
                    bench_json_double(&json, "operation_count", operations);
                    bench_json_double(&json, "peak_throughput", peak);
                    bench_json_double(&json, "median_throughput", median);
                    bench_json_string(&json, "unit", unit);
                    bench_json_string(&json, "status", "ok");
                    bench_json_string(&json, "correctness",
                        "all chain outputs exact against the host recurrence (zero tolerance)");
                    bench_json_double(&json, "max_abs_error", max_absolute_error);
                    bench_json_timing(&json, &timing);
                    bench_json_close_object(&json);
                }
            } else {
                printf("%8u   timing did not resolve\n", blocks);
            }
        }

        aclrtFree(device_state); aclrtFree(device_coefficients); aclrtFree(device_output);
        free(host_state); free(host_coefficients);
        free(reference_state); free(reference_a); free(reference_b);
    }

    if (output) bench_json_close_array(&json);

    if (any_ok) {
        printf("\nMeasured vector %s peak: %.3f %s (same configuration median %.3f %s) at %u blocks\n",
               kDtypeName, best_peak, unit, best_median, unit, best_blocks);
        if (output) {
            bench_json_return_to_root(&json);
            bench_json_string(&json, "status",
                kNativeArithmetic ? "ok" : "measured_widened");
            bench_json_double(&json, "value", best_peak);
            bench_json_double(&json, "median_value", best_median);
            bench_json_int(&json, "best_blocks", best_blocks);
        }
    } else {
        printf("\nNo configuration produced a validated measurement.\n");
        if (output) {
            bench_json_return_to_root(&json);
            bench_json_string(&json, "status", "error");
            bench_json_string(&json, "reason", "no configuration validated and timed");
            bench_json_null(&json, "value");
            bench_json_null(&json, "median_value");
        }
    }

    if (output) {
                bench_json_device(&json, &device);
        bench_json_end_document(&json);
        fclose(output);
        printf("JSON: %s\n", output_path);
    }

    BENCH_CHECK(aclrtDestroyStream(stream));
    BENCH_CHECK(aclrtResetDevice(device_id));
    aclFinalize();
    return any_ok ? 0 : 1;
}
